language "law.core" version "0.2";
package la.aquinas.reconstruct.i_ii_q90_a4 version "0.1.0";
namespace "urn:la:aquinas:reconstruction:i-ii-q90-a4";

test "binding: positive and removal" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "p1": source_co_rule_application() { origin case_input; }
  assert "p2": source_co_binding_force() { origin case_input; }
  assert "p3": rule_assigned_to_addressees() { origin case_input; }
  assert "p4": promulgation_makes_known() { origin case_input; }
  assert "p5": addressee_should_be_ruled() { origin case_input; }
 }
 evaluate truth(rule_applied_to_addressees());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(promulgation_brings_rule_to_knowledge());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(binding_force_from_application());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate argumentation(binding_force_from_application());
 expect issues_within(error);
 expect argumentation_class(SKEPTICALLY_ACCEPTED);
}

test "binding: explicit removal blocks dependent conclusions" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "r1": source_co_rule_application() { origin case_input; }
  assert "r2": source_co_binding_force() { origin case_input; }
  assert "r3": rule_assigned_to_addressees() { origin case_input; }
  assert "r4": addressee_should_be_ruled() { origin case_input; }
  assert "removed": not promulgation_makes_known() { origin case_input; }
 }
 evaluate truth(promulgation_brings_rule_to_knowledge());
 expect result_kind == PROPOSITION;
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
 evaluate truth(binding_force_from_application());
 expect result_kind == PROPOSITION;
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
}
