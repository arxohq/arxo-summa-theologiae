language "law.core" version "0.2";
package la.aquinas.reconstruct.i_ii_q90_a4 version "0.1.0";
namespace "urn:la:aquinas:reconstruction:i-ii-q90-a4";

test "future: positive and removal" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "p1": source_ad3_future_extension() { origin case_input; }
  assert "p2": source_ad3_reading() { origin case_input; }
  assert "p3": present_promulgation_occurred() { origin case_input; }
  assert "p4": durable_written_promulgation() { origin case_input; }
 }
 evaluate truth(future_addressee_reached_by_durable_writing());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}

test "future: explicit removal blocks dependent conclusions" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "r1": source_ad3_future_extension() { origin case_input; }
  assert "r2": source_ad3_reading() { origin case_input; }
  assert "still-durable": durable_written_promulgation() { origin case_input; }
  assert "removed": not present_promulgation_occurred() { origin case_input; }
 }
 evaluate truth(future_addressee_reached_by_durable_writing());
 expect result_kind == PROPOSITION;
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
}
