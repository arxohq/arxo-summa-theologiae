language "law.core" version "0.2";
package la.aquinas.reconstruct.i_ii_q90_a4 version "0.1.0";
namespace "urn:la:aquinas:reconstruction:i-ii-q90-a4";

test "remote: positive and removal" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "p1": source_ad2_transmission() { origin case_input; }
  assert "p2": promulgation_actually_occurred() { origin case_input; }
  assert "p3": remote_addressee_learns_by_others() { origin case_input; }
 }
 evaluate truth(remote_addressee_reached_by_transmission());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}

test "remote: explicit removal blocks dependent conclusions" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "r1": source_ad2_transmission() { origin case_input; }
  assert "still-learns": remote_addressee_learns_by_others() { origin case_input; }
  assert "removed": not promulgation_actually_occurred() { origin case_input; }
 }
 evaluate truth(remote_addressee_reached_by_transmission());
 expect result_kind == PROPOSITION;
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
}
