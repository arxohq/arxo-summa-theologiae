language "law.core" version "0.2";
package la.aquinas.reconstruct.i_ii_q90_a4 version "0.1.0";
namespace "urn:la:aquinas:reconstruction:i-ii-q90-a4";

test "natural law: insertion and cognoscibility promulgate" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "f1": source_ad1_natural_insertion() { origin case_input; }
  assert "f2": source_ad1_natural_cognoscibility() { origin case_input; }
  assert "f3": natural_law_inserted_and_knowable() { origin case_input; }
 }
 evaluate truth(natural_insertion_promulgates_natural_law());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}

test "natural law: without insertion-and-knowledge premise route stays open" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "f1": source_ad1_natural_insertion() { origin case_input; }
  assert "f2": source_ad1_natural_cognoscibility() { origin case_input; }
  assert "removed": not natural_law_inserted_and_knowable() { origin case_input; }
 }
 evaluate truth(natural_insertion_promulgates_natural_law());
 expect result_kind == PROPOSITION;
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
}
