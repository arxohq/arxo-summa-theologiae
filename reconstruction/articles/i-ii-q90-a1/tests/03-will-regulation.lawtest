language "law.core" version "0.2";
package la.aquinas.reconstruct.i_ii_q90_a1 version "0.1.0";
namespace "urn:la:aquinas:reconstruction:i-ii-q90-a1";

test "will: positive and removal" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "p1": source_ad3_reason_moved_by_will() { origin case_input; }
  assert "p2": source_ad3_will_reason_regulated() { origin case_input; }
  assert "p3": will_directed_to_end() { origin case_input; }
  assert "p4": will_reason_regulated() { origin case_input; }
 }
 evaluate truth(will_motivates_reason());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(will_command_reason_regulated());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(will_has_law_character());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}

test "will: explicit removal blocks dependent conclusions" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "r1": source_ad3_reason_moved_by_will() { origin case_input; }
  assert "r2": source_ad3_will_reason_regulated() { origin case_input; }
  assert "r3": will_directed_to_end() { origin case_input; }
  assert "removed": not will_reason_regulated() { origin case_input; }
 }
 evaluate truth(will_command_reason_regulated());
 expect result_kind == PROPOSITION;
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
 evaluate truth(will_has_law_character());
 expect result_kind == PROPOSITION;
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
}
