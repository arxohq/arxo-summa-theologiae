language "law.core" version "0.2";
package la.aquinas.reconstruct.i_ii_q90_a3 version "0.1.0";
namespace "urn:la:aquinas:reconstruction:i-ii-q90-a3";

test "caretaker: positive and removal" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "p1": source_co_common_good_scope() { origin case_input; }
  assert "p2": source_co_caretaker() { origin case_input; }
  assert "p3": source_co_end_authority() { origin case_input; }
  assert "p4": public_office_has_care_of_whole() { origin case_input; }
  assert "p5": source_ad2_virtue_goal() { origin case_input; }
  assert "p6": source_ad2_public_penalty() { origin case_input; }
  assert "p7": public_coercive_power() { origin case_input; }
 }
 evaluate truth(public_caretaker_of_whole());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(public_caretaker_common_good_route());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(public_coercive_lawmaking_route());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate argumentation(public_caretaker_common_good_route());
 expect issues_within(error);
 expect argumentation_class(SKEPTICALLY_ACCEPTED);
}

test "caretaker: explicit removal blocks dependent conclusions" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "r1": source_co_common_good_scope() { origin case_input; }
  assert "r2": source_co_caretaker() { origin case_input; }
  assert "r3": source_co_end_authority() { origin case_input; }
  assert "r4": public_office_has_care_of_whole() { origin case_input; }
  assert "r5": source_ad2_virtue_goal() { origin case_input; }
  assert "r6": source_ad2_public_penalty() { origin case_input; }
  assert "removed": not public_coercive_power() { origin case_input; }
 }
 evaluate truth(public_coercive_lawmaking_route());
 expect result_kind == PROPOSITION;
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
}
