language "law.core" version "0.2";
package la.aquinas.reconstruct.i_ii_q90_a3 version "0.1.0";
namespace "urn:la:aquinas:reconstruction:i-ii-q90-a3";

test "whole multitude: direct common-good route" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "source": source_co_common_good_scope() { origin case_input; }
  assert "whole": whole_multitude_orders_good() { origin case_input; }
 }
 evaluate truth(whole_multitude_common_good_route());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}

test "whole multitude: explicit absence removes that route" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "source": source_co_common_good_scope() { origin case_input; }
  assert "whole-absent": not whole_multitude_orders_good() { origin case_input; }
 }
 evaluate truth(whole_multitude_common_good_route());
 expect result_kind == PROPOSITION;
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
}
