language "law.core" version "0.2";
package la.aquinas.reconstruct.ii_ii_q64_a7 version "0.1.0";
namespace "urn:la:aquinas:reconstruction:ii-ii-q64-a7";

test "ad4 keeps the two necessity comparisons distinct" {
    given {
        context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
        assert "compared-act": fornication_or_adultery_act(entity_ref("urn:case:q64a7:p1"), entity_ref("urn:case:q64a7:comparison")) { origin case_input; }
        assert "not-necessary": not necessity_to_preserve_life(entity_ref("urn:case:q64a7:p1"), entity_ref("urn:case:q64a7:comparison")) { origin case_input; }
        assert "defensive-act": defensive_act_from_which_homicide_follows(entity_ref("urn:case:q64a7:p1"), entity_ref("urn:case:q64a7:act1")) { origin case_input; }
        assert "necessary-defense": necessity_to_preserve_life(entity_ref("urn:case:q64a7:p1"), entity_ref("urn:case:q64a7:act1")) { origin case_input; }
    }
    evaluate truth(fornication_or_adultery_not_necessary_for_life(entity_ref("urn:case:q64a7:p1"), entity_ref("urn:case:q64a7:comparison")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(defense_effect_can_follow_from_necessity(entity_ref("urn:case:q64a7:p1"), entity_ref("urn:case:q64a7:act1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "ad4 comparison branch disappears when non-necessity premise is removed" {
    given {
        context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
        assert "compared-act": fornication_or_adultery_act(entity_ref("urn:case:q64a7:p1"), entity_ref("urn:case:q64a7:comparison")) { origin case_input; }
    }
    evaluate truth(fornication_or_adultery_not_necessary_for_life(entity_ref("urn:case:q64a7:p1"), entity_ref("urn:case:q64a7:comparison")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
