language "law.core" version "0.2";
package la.aquinas.reconstruct.i_q1_a8 version "0.1.0";
namespace "urn:la:aquinas:reconstruction:i-q1-a8";

source SummaSTI_Q1_A8 {
    kind theological_primary_text;
    authority "Thomas Aquinas";
    number "Summa Theologiae I q. 1 a. 8; https://www.corpusthomisticum.org/sth1001.html";
}

// Typed source vocabulary. These are stipulated source principles and case
// facts, not independently verified truths.
relation faith_article(article: Text) kind empirical;
relation doctrine_principle(principle: Text) kind empirical;
relation source_derivation(principle: Text, conclusion: Text) kind empirical;
relation opponent_grants(opponent: Text, principle: Text) kind empirical;
relation opponent_grants_none(opponent: Text) kind empirical;
relation authority_supports(authority: Text, claim: Text) kind empirical;
relation canonical_authority(authority: Text) kind empirical;
relation revelation_recipient(authority: Text) kind empirical;
relation church_doctor_authority(authority: Text) kind empirical;
relation philosopher_authority(authority: Text) kind empirical;
relation natural_reason_knows(claim: Text) kind empirical;
relation human_reason_used_for(reasoner: Text, article: Text) kind empirical;
relation natural_reason_manifests(reasoner: Text, matter: Text) kind empirical;

relation available_argument(opponent: Text, conclusion: Text) kind derived;
relation answerable_objection(opponent: Text) kind derived;
relation necessary_authority_support(authority: Text, claim: Text) kind derived;
relation probable_authority_support(authority: Text, claim: Text) kind derived;
relation human_reason_proof_excluded(reasoner: Text, article: Text) kind derived;

// Protected targets are declared for audit visibility and deliberately have no
// asserting rules or input facts.
relation proves_faith_article(reasoner: Text, article: Text) kind derived;
relation doctrine_argumentative(doctrine: Text) kind derived;
relation infallible_truth(claim: Text) kind derived;

@source(SummaSTI_Q1_A8)
rule DeriveOtherConclusionFromGrantedPrinciple(opponent: Text, principle: Text, conclusion: Text) strict {
    when opponent_grants(opponent, principle);
    when doctrine_principle(principle);
    when source_derivation(principle, conclusion);
    then available_argument(opponent, conclusion);
}

@source(SummaSTI_Q1_A8)
rule AnswerObjectionsWhenNoPrincipleGranted(opponent: Text) strict {
    when opponent_grants_none(opponent);
    then answerable_objection(opponent);
}

@source(SummaSTI_Q1_A8)
rule CanonicalRevelationAuthorityIsNecessary(authority: Text, claim: Text) strict {
    when canonical_authority(authority);
    when revelation_recipient(authority);
    when authority_supports(authority, claim);
    then necessary_authority_support(authority, claim);
}

@source(SummaSTI_Q1_A8)
rule ChurchDoctorAuthorityIsProbable(authority: Text, claim: Text) strict {
    when church_doctor_authority(authority);
    when authority_supports(authority, claim);
    then probable_authority_support(authority, claim);
}

@source(SummaSTI_Q1_A8)
rule PhilosopherAuthorityIsProbable(authority: Text, claim: Text) strict {
    when philosopher_authority(authority);
    when natural_reason_knows(claim);
    when authority_supports(authority, claim);
    then probable_authority_support(authority, claim);
}

@source(SummaSTI_Q1_A8)
rule HumanReasonDoesNotProveFaithArticle(reasoner: Text, article: Text) strict {
    when human_reason_used_for(reasoner, article);
    when faith_article(article);
    then human_reason_proof_excluded(reasoner, article);
}
