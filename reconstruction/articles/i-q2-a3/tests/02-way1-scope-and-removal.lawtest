language "law.core" version "0.2";
package la.aquinas.reconstruct.i_q2_a3 version "0.1.0";
namespace "urn:la:aquinas:reconstruction:i-q2-a3";

test "a potential state that differs from the actualized target blocks the witness" {
    given {
        context { legal_time @2026-10-13; knowledge_time @2026-10-13T00:00:00Z; decision_time @2026-10-13T00:00:00Z; timezone "UTC"; }
        assert state_before("wood", "temperature", "cold") { origin case_input; }
        assert in_potency("wood", "temperature", "warm") { origin case_input; }
        assert in_act("fire", "temperature", "hot") { origin case_input; }
        assert actualizes("fire", "wood", "temperature", "cold", "hot") { origin case_input; }
    }
    evaluate truth(finite_actualization("wood", "temperature", "fire", "cold", "hot"));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "an aspect mismatch blocks the actualization witness" {
    given {
        context { legal_time @2026-10-13; knowledge_time @2026-10-13T00:00:00Z; decision_time @2026-10-13T00:00:00Z; timezone "UTC"; }
        assert state_before("wood", "temperature", "cold") { origin case_input; }
        assert in_potency("wood", "temperature", "hot") { origin case_input; }
        assert in_act("fire", "color", "red") { origin case_input; }
        assert actualizes("fire", "wood", "temperature", "cold", "hot") { origin case_input; }
    }
    evaluate truth(finite_actualization("wood", "temperature", "fire", "cold", "hot"));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "same-agent movement does not satisfy the source claim that a moved thing is moved by another" {
    given {
        context { legal_time @2026-10-13; knowledge_time @2026-10-13T00:00:00Z; decision_time @2026-10-13T00:00:00Z; timezone "UTC"; }
        assert state_before("subject", "shape", "round-potential") { origin case_input; }
        assert in_potency("subject", "shape", "round-actual") { origin case_input; }
        assert in_act("subject", "shape", "round-actual") { origin case_input; }
        assert actualizes("subject", "subject", "shape", "round-potential", "round-actual") { origin case_input; }
    }
    evaluate truth(finite_actualization("subject", "shape", "subject", "round-potential", "round-actual"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(moved_by_another("subject", "shape", "subject"));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
