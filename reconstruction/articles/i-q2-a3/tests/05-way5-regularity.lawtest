language "law.core" version "0.2";
package la.aquinas.reconstruct.i_q2_a3 version "0.1.0";
namespace "urn:la:aquinas:reconstruction:i-q2-a3";

test "two observed occurrences support only a finite regular pattern" {
    given {
        context { legal_time @2026-10-13; knowledge_time @2026-10-13T00:00:00Z; decision_time @2026-10-13T00:00:00Z; timezone "UTC"; }
        assert observed_action("plant-A", "grow-toward-light", "healthy-growth", "observation-1") { origin case_input; }
        assert observed_action("plant-A", "grow-toward-light", "healthy-growth", "observation-2") { origin case_input; }
        assert distinct_occurrences("plant-A", "observation-1", "observation-2") { origin case_input; }
        assert outcome_is_best("healthy-growth") { origin case_input; }
    }
    evaluate truth(finite_regular_pattern_toward_end("plant-A", "grow-toward-light", "healthy-growth"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(intelligent_director("director-A"));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "without a best-outcome premise the regularity rule does not fire" {
    given {
        context { legal_time @2026-10-13; knowledge_time @2026-10-13T00:00:00Z; decision_time @2026-10-13T00:00:00Z; timezone "UTC"; }
        assert observed_action("plant-B", "grow", "outcome-B", "obs-1") { origin case_input; }
        assert observed_action("plant-B", "grow", "outcome-B", "obs-2") { origin case_input; }
        assert distinct_occurrences("plant-B", "obs-1", "obs-2") { origin case_input; }
    }
    evaluate truth(finite_regular_pattern_toward_end("plant-B", "grow", "outcome-B"));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
