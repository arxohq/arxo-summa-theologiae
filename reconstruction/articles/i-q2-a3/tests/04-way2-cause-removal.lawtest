language "law.core" version "0.2";
package la.aquinas.reconstruct.i_q2_a3 version "0.1.0";
namespace "urn:la:aquinas:reconstruction:i-q2-a3";

test "removing one causal edge removes the two-link path and designated-start witness" {
    given {
        context { legal_time @2026-10-13; knowledge_time @2026-10-13T00:00:00Z; decision_time @2026-10-13T00:00:00Z; timezone "UTC"; }
        assert designated_chain_start("root-B", "efficient-cause-order") { origin case_input; }
        assert efficient_cause("root-B", "middle-B") { origin case_input; }
    }
    evaluate truth(finite_cause_edge("root-B", "middle-B"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(finite_two_link_cause_path("root-B", "effect-B"));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(finite_path_from_designated_start("root-B", "effect-B"));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
