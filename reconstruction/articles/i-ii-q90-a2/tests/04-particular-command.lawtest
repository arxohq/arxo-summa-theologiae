language "law.core" version "0.2";
package la.aquinas.reconstruct.i_ii_q90_a2 version "0.1.0";
namespace "urn:la:aquinas:reconstruction:i-ii-q90-a2";

test "particular command: ordered precept and derivative private good" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "f1": source_co_first_principle_practical_is_ultimate_end() { origin case_input; }
  assert "f2": source_co_human_life_ultimate_end_happiness() { origin case_input; }
  assert "f2b": source_prior_human_ultimate_end_is_happiness() { origin case_input; }
  assert "f3": source_co_part_whole() { origin case_input; }
  assert "f4": source_co_person_part_community() { origin case_input; }
  assert "f5": source_co_community_perfect() { origin case_input; }
  assert "f6": source_co_focal_analogy() { origin case_input; }
  assert "bridge": bridge_law_end_tracks_complete_community_happiness() { origin case_input; }
  assert "f7": source_ad1_application() { origin case_input; }
  assert "f8": particular_command_applies_law() { origin case_input; }
  assert "f9": particular_good() { origin case_input; }
 }
 evaluate truth(particular_precept_ordered_to_common_good());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(particular_good_has_law_character());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}

test "particular command: removal blocks derivative classification" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "f1": source_co_first_principle_practical_is_ultimate_end() { origin case_input; }
  assert "f2": source_co_human_life_ultimate_end_happiness() { origin case_input; }
  assert "f2b": source_prior_human_ultimate_end_is_happiness() { origin case_input; }
  assert "f3": source_co_part_whole() { origin case_input; }
  assert "f4": source_co_person_part_community() { origin case_input; }
  assert "f5": source_co_community_perfect() { origin case_input; }
  assert "f6": source_co_focal_analogy() { origin case_input; }
  assert "bridge": bridge_law_end_tracks_complete_community_happiness() { origin case_input; }
  assert "f7": source_ad1_application() { origin case_input; }
  assert "f8": particular_good() { origin case_input; }
  assert "removed": not particular_command_applies_law() { origin case_input; }
 }
 evaluate truth(particular_precept_ordered_to_common_good());
 expect result_kind == PROPOSITION;
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
 evaluate truth(particular_good_has_law_character());
 expect result_kind == PROPOSITION;
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
}
