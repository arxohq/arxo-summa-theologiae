language "law.core" version "0.2";
package la.aquinas.reconstruct.i_ii_q90_a2 version "0.1.0";
namespace "urn:la:aquinas:reconstruction:i-ii-q90-a2";

test "final cause: positive and removal" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "p1": source_co_first_principle_practical_is_ultimate_end() { origin case_input; }
  assert "p2": source_co_human_life_ultimate_end_happiness() { origin case_input; }
  assert "p2b": source_prior_human_ultimate_end_is_happiness() { origin case_input; }
  assert "p3": source_co_part_whole() { origin case_input; }
  assert "p4": source_co_person_part_community() { origin case_input; }
  assert "p5": source_co_community_perfect() { origin case_input; }
  assert "p6": source_co_focal_analogy() { origin case_input; }
  assert "bridge": bridge_law_end_tracks_complete_community_happiness() { origin case_input; }
  assert "p7": source_ad2_final_cause() { origin case_input; }
  assert "p8": particular_act() { origin case_input; }
 }
 evaluate truth(law_ordered_to_common_happiness());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(particular_act_referred_by_final_cause());
 expect result_kind == PROPOSITION;
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}

test "final cause: explicit removal blocks dependent conclusions" {
 given {
  context { legal_time @2026-10-13; decision_time @2026-10-13T12:00:00Z; knowledge_time @2026-10-13T12:00:00Z; timezone "UTC"; }
  assert "r1": source_co_first_principle_practical_is_ultimate_end() { origin case_input; }
  assert "r2": source_co_human_life_ultimate_end_happiness() { origin case_input; }
  assert "r2b": source_prior_human_ultimate_end_is_happiness() { origin case_input; }
  assert "r3": source_co_part_whole() { origin case_input; }
  assert "r4": source_co_person_part_community() { origin case_input; }
  assert "r5": source_co_community_perfect() { origin case_input; }
  assert "r6": source_co_focal_analogy() { origin case_input; }
  assert "bridge": bridge_law_end_tracks_complete_community_happiness() { origin case_input; }
  assert "r7": particular_act() { origin case_input; }
  assert "removed": not source_ad2_final_cause() { origin case_input; }
 }
 evaluate truth(particular_act_referred_by_final_cause());
 expect result_kind == PROPOSITION;
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
}
