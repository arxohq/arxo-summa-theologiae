language "law.core" version "0.2";
package examples.aquinas.moral_cases version "0.1.0";
namespace "urn:law:examples:aquinas:moral-cases";

// Те же факты путника, без vis_moderata: мера защиты не на деле.
case ViatorSineModeramine {
    context {
        legal_time @1270-06-01;
        knowledge_time @1270-06-01T12:00:00Z;
        decision_time @1270-06-01T12:00:00Z;
        timezone "UTC";
    }

    assert "presented": la.aquinas.duplex_effectus::presented_actus(entity_ref("urn:example:duplex:actus:viator")) { origin case_input; }
    assert "defensor": la.aquinas.duplex_effectus::defensor(entity_ref("urn:example:duplex:actus:viator"), entity_ref("urn:example:duplex:persona:viator")) { origin case_input; }
    assert "vis": la.aquinas.duplex_effectus::vis_illata(entity_ref("urn:example:duplex:actus:viator")) { origin case_input; }
    assert "finis": la.aquinas.duplex_effectus::intentio_conservationis_vitae(entity_ref("urn:example:duplex:actus:viator")) { origin case_input; }
    assert "non-occisio": not la.aquinas.duplex_effectus::intentio_occisionis(entity_ref("urn:example:duplex:actus:viator")) { origin case_input; }
    assert "non-medium": not la.aquinas.duplex_effectus::mors_est_medium(entity_ref("urn:example:duplex:actus:viator")) { origin case_input; }
    assert "privatus": not la.aquinas.duplex_effectus::publicus_minister(entity_ref("urn:example:duplex:persona:viator")) { origin case_input; }
}
