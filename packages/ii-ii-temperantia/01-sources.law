}

fragment ST_II_II_Q149_PR in LEONINA_CT_Q149 {
    kind paragraph;
    locator "question/149/prooemium";
    text la official """[44939] IIª-IIae, q. 149 pr. Deinde considerandum est de sobrietate, et vitio opposito, scilicet ebrietate. Et circa sobrietatem quaeruntur quatuor. Primo, quae sit materia sobrietatis. Secundo, utrum sit specialis virtus. Tertio, utrum usus vini sit licitus. Quarto, quibus praecipue competat sobrietas.""";
    content_hash "sha256:b901af4a865e71e69223653396b428fd6068ee3a34b7952a23e0b8c2e2b32a48";
}

fragment ST_II_II_Q149_A1_ARG1 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-1/objection/1";
    text la official """[44940] IIª-IIae, q. 149 a. 1 arg. 1 Ad primum sic proceditur. Videtur quod materia propria sobrietatis non sit potus. Dicitur enim Rom. XII. Non plus sapere quam oportet sapere, sed sapere ad sobrietatem. Ergo sobrietas est etiam circa sapientiam, et non solum circa potum.""";
    content_hash "sha256:398f05c50e38718e819f38d68c7442a1b4ffed1b3c7e7f3162cf7460db0425cd";
}

fragment ST_II_II_Q149_A1_ARG2 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-1/objection/2";
    text la official """[44941] IIª-IIae, q. 149 a. 1 arg. 2 Praeterea, Sap. VIII dicitur de Dei sapientia quod sobrietatem et prudentiam docet, iustitiam et virtutem, ubi sobrietatem ponit pro temperantia. Sed temperantia non solum est circa potus, sed etiam circa cibos et venerea. Ergo sobrietas non solum est circa potus.""";
    content_hash "sha256:f26e09f4a6f7ddbfa035a06836fc5e0e9e42b0a24ce39bdbc26d312cb9b5abfc";
}

fragment ST_II_II_Q149_A1_ARG3 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-1/objection/3";
    text la official """[44942] IIª-IIae, q. 149 a. 1 arg. 3 Praeterea, nomen sobrietatis a mensura sumptum esse videtur. Sed in omnibus quae ad nos pertinent debemus mensuram servare, unde dicitur Tit. II, sobrie et iuste et pie vivamus, ubi dicit Glossa, sobrie, in nobis, et I ad Tim. II dicitur, mulieres in habitu ornato, cum verecundia et sobrietate ornantes se, et sic videtur sobrietas esse non solum in interioribus, sed etiam in his quae pertinent ad exteriorem habitum. Non ergo propria materia sobrietatis est potus.""";
    content_hash "sha256:454d37b95166b335920c415556b98d26eba530b428111feeae78f4310d66a851";
}

fragment ST_II_II_Q149_A1_SC in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-1/sed-contra";
    text la official """[44943] IIª-IIae, q. 149 a. 1 s. c. Sed contra est quod dicitur Eccli. XXXI, aequa vita hominis vinum in sobrietate potatum.""";
    content_hash "sha256:e68c5f2527ad348a6c19437ac96da8d640caa9b7c97fa2a8a941e2c9927e7edd";
}

fragment ST_II_II_Q149_A1_RESP in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-1/respondeo";
    text la official """[44944] IIª-IIae, q. 149 a. 1 co. Respondeo dicendum quod virtutes quae ab aliqua generali conditione virtutis nominantur, illam materiam specialiter sibi vindicant in qua difficillimum et optimum est conditionem huiusmodi observare, sicut fortitudo pericula mortis, et temperantia delectationes tactus. Nomen autem sobrietatis sumitur a mensura, dicitur enim aliquis sobrius quasi briam, idest mensuram, servans. Et ideo illam materiam specialiter sibi sobrietas adscribit in qua maxime laudabile est mensuram servare. Huiusmodi autem est potus inebriare valens, quia eius usus mensuratus multum confert, et modicus excessus multum laedit, quia impedit usum rationis, magis etiam quam excessus cibi. Unde dicitur Eccli. XXXI, sanitas est animae et corporis sobrius potus. Vinum multum potatum irritationem et iram et ruinas multas facit. Et ideo specialiter sobrietas attenditur circa potum, non quemcumque, sed eum qui sua fumositate natus est caput conturbare, sicut vinum et omne quod inebriare potest. Communiter autem sumendo nomen sobrietatis, potest in quacumque materia dici, sicut et supra dictum est de fortitudine et temperantia.""";
    content_hash "sha256:2318daff8e3fa6b2d3fd1149ead79e7b9f71557d6e9ebc8001d56291f466f29a";
}

fragment ST_II_II_Q149_A1_AD1 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-1/reply/1";
    text la official """[44945] IIª-IIae, q. 149 a. 1 ad 1 Ad primum ergo dicendum quod, sicut vinum materiale corporaliter inebriat, ita etiam metaphorice consideratio sapientiae dicitur potus inebrians, propter hoc quod sua delectatione animum allicit, secundum illud Psalmi, calix meus inebrians quam praeclarus est, et ideo circa contemplationem sapientiae per similitudinem quandam sobrietas dicitur.""";
    content_hash "sha256:253e5ccf148f95f235c3401d7e3bf06ae7d3957a3633c48beab921e582dfe18b";
}

fragment ST_II_II_Q149_A1_AD2 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-1/reply/2";
    text la official """[44946] IIª-IIae, q. 149 a. 1 ad 2 Ad secundum dicendum quod omnia quae ad temperantiam proprie pertinent, necessaria sunt praesenti vitae, et eorum excessus nocet. Et ideo in omnibus necessarium est adhibere mensuram, quod pertinet ad officium sobrietatis. Propter quod nomine sobrietatis temperantia significatur. Sed modicus excessus in potu plus nocet quam in aliis. Et ideo sobrietas specialiter est circa potum.""";
    content_hash "sha256:8295d42023167967501c7a8961eb7157b45215409c48cab1f83f2bf481a23a25";
}

fragment ST_II_II_Q149_A1_AD3 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-1/reply/3";
    text la official """[44947] IIª-IIae, q. 149 a. 1 ad 3 Ad tertium dicendum quod, quamvis mensura in omnibus requiratur, non tamen sobrietas proprie in omnibus dicitur, sed in quibus mensura est maxime necessaria.""";
    content_hash "sha256:b46faa2760c012319309fbceafe4e8dd01e2cd2b1404df946bc9012ddc54a2d6";
}

fragment ST_II_II_Q149_A2_ARG1 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-2/objection/1";
    text la official """[44948] IIª-IIae, q. 149 a. 2 arg. 1 Ad secundum sic proceditur. Videtur quod sobrietas non sit per se quaedam specialis virtus. Abstinentia enim attenditur et circa cibos et potus. Sed circa cibos specialiter non est aliqua specialis virtus. Ergo nec sobrietas, quae est circa potus, est specialis virtus.""";
    content_hash "sha256:ce8a64051e70cae4a60fc3804fce2128009cb69771caab59b0a38db6757bb380";
}

fragment ST_II_II_Q149_A2_ARG2 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-2/objection/2";
    text la official """[44949] IIª-IIae, q. 149 a. 2 arg. 2 Praeterea, abstinentia et gula sunt circa delectationes tactus inquantum est sensus alimenti. Sed cibus et potus simul cedunt in alimentum, simul enim indiget animal nutriri humido et sicco. Ergo sobrietas, quae est circa potum, non est specialis virtus.""";
    content_hash "sha256:cb32378ac39cdfc91dac5b2ae71939d8a242f32738330d43c698a5f94186d0aa";
}

fragment ST_II_II_Q149_A2_ARG3 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-2/objection/3";
    text la official """[44950] IIª-IIae, q. 149 a. 2 arg. 3 Praeterea, sicut in his quae ad nutritionem pertinent distinguitur potus a cibo, ita etiam distinguuntur diversa genera ciborum et diversa genera potuum. Si ergo sobrietas esset per se quaedam specialis virtus, videtur quod circa quamlibet differentiam potus vel cibi sit quaedam specialis virtus, quod est inconveniens. Non ergo videtur quod sobrietas sit specialis virtus.""";
    content_hash "sha256:278fe9afd6ba30d929e5811375c459221820288d4ce3370504a4d7a388dda795";
}

fragment ST_II_II_Q149_A2_SC in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-2/sed-contra";
    text la official """[44951] IIª-IIae, q. 149 a. 2 s. c. Sed contra est quod Macrobius ponit sobrietatem specialem partem temperantiae.""";
    content_hash "sha256:8d77bf77405decbc196bed4b5e2c2abc7b0d6c3be83d59dd3a9d061fe6202d3f";
}

fragment ST_II_II_Q149_A2_RESP in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-2/respondeo";
    text la official """[44952] IIª-IIae, q. 149 a. 2 co. Respondeo dicendum quod, sicut supra dictum est, ad virtutem moralem pertinet conservare bonum rationis contra ea quibus potest impediri, et ideo, ubi invenitur speciale impedimentum rationis, ibi necesse est esse specialem virtutem ad illud removendum. Potus autem inebrians habet specialem rationem impediendi rationis usum, inquantum scilicet perturbat cerebrum sua fumositate. Et ideo, ad removendum hoc impedimentum rationis, requiritur specialis virtus, quae est sobrietas.""";
    content_hash "sha256:106729928d860e5bdb9c9c6157dc9911efd04bcc8905f233fcd1cef7b7598371";
}

fragment ST_II_II_Q149_A2_AD1 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-2/reply/1";
    text la official """[44953] IIª-IIae, q. 149 a. 2 ad 1 Ad primum ergo dicendum quod cibus et potus communiter impedire possunt bonum rationis absorbendo eam per immoderantiam delectationis. Et quantum ad hoc, communiter circa cibum et potum est abstinentia. Sed potus inebriare valens impedit speciali ratione, ut dictum est. Et ideo requirit specialem virtutem.""";
    content_hash "sha256:bd370d730895db7ab07c2c624b1da7f8b6ede00fa8c717dddafbeda2415e7099";
}

fragment ST_II_II_Q149_A2_AD2 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-2/reply/2";
    text la official """[44954] IIª-IIae, q. 149 a. 2 ad 2 Ad secundum dicendum quod virtus abstinentiae non est circa cibos et potus inquantum sunt nutritiva, sed inquantum impediunt rationem. Et ideo non oportet quod specialitas virtutis attendatur secundum rationem nutritionis.""";
    content_hash "sha256:4aba510bcbf63563aa3624548114e0220e7490bcd14aeb955d83325fb2c97410";
}

fragment ST_II_II_Q149_A2_AD3 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-2/reply/3";
    text la official """[44955] IIª-IIae, q. 149 a. 2 ad 3 Ad tertium dicendum quod in omnibus potibus inebriare valentibus est una et eadem ratio impediendi usum rationis. Et sic illa potuum diversitas per accidens se habet ad virtutem. Et propter hoc, secundum huiusmodi diversitatem virtutes non diversificantur. Et eadem ratio est de diversitate ciborum.""";
    content_hash "sha256:b8c9619aca48d1feebba6b01c1db321a95a23776a9e7b02d57b6fc6a208a5999";
}

fragment ST_II_II_Q149_A3_ARG1 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-3/objection/1";
    text la official """[44956] IIª-IIae, q. 149 a. 3 arg. 1 Ad tertium sic proceditur. Videtur quod usus vini totaliter sit illicitus. Sine sapientia enim non potest aliquis esse in statu salutis, dicitur enim Sap. VII, neminem diligit Deus nisi qui cum sapientia inhabitat; et infra, IX, per sapientiam sanati sunt quicumque placuerunt tibi a principio. Sed usus vini impedit sapientiam, dicitur enim Eccle. II, cogitavi abstrahere a vino carnem meam, ut transferrem animam meam ad sapientiam. Ergo potus vini est universaliter illicitus.""";
    content_hash "sha256:84d7aef2b2d7ddcbda9b15c1fa2c0b81713962688885dda151f539b7e436eeea";
}

fragment ST_II_II_Q149_A3_ARG2 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-3/objection/2";
    text la official """[44957] IIª-IIae, q. 149 a. 3 arg. 2 Praeterea, apostolus dicit, Rom. XIV, bonum est non manducare carnem et non bibere vinum, neque in quo frater tuus offenditur aut scandalizatur aut infirmatur. Sed cessare a bono virtutis est vitiosum, et similiter fratribus scandalum ponere. Ergo uti vino est illicitum.""";
    content_hash "sha256:be3f187dbbccce619b525b96659a42a7a69d2c9d0d3d769d364a3f58671ef51c";
}

fragment ST_II_II_Q149_A3_ARG3 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-3/objection/3";
    text la official """[44958] IIª-IIae, q. 149 a. 3 arg. 3 Praeterea, Hieronymus dicit quod vinum cum carnibus post diluvium est dedicatum, Christus autem venit in fine saeculorum, et extremitatem retraxit ad principium. Ergo, tempore Christianae legis, videtur esse illicitum vino uti.""";
    content_hash "sha256:d4f47aef0dc76f19c5f1049acc5836be4b933a24ae169bc9a506b8e71d62c81c";
}

fragment ST_II_II_Q149_A3_SC in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-3/sed-contra";
    text la official """[44959] IIª-IIae, q. 149 a. 3 s. c. Sed contra est quod apostolus dicit, I ad Tim. V, noli adhuc aquam bibere, sed modico vino utere, propter stomachum tuum et frequentes infirmitates. Et Eccli. XXXI dicitur, exultatio animae et cordis vinum moderate potatum.""";
    content_hash "sha256:796e2742bb288a3ae728d9dba05bf9e081f449dd0aec0dd23ad3eb96337f23f8";
}

fragment ST_II_II_Q149_A3_RESP in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-3/respondeo";
    text la official """[44960] IIª-IIae, q. 149 a. 3 co. Respondeo dicendum quod nullus cibus vel potus, secundum se consideratus, est illicitus, secundum sententiam domini dicentis, Matth. XV, nihil quod intrat in os, coinquinat hominem. Et ideo bibere vinum, secundum se loquendo, non est illicitum. Potest tamen illicitum reddi per accidens. Quandoque quidem ex conditione bibentis, qui a vino de facili laeditur, vel qui ex speciali voto obligatur ad vinum non bibendum. Quandoque autem ex modo bibendi, quia scilicet mensuram in bibendo excedit. Quandoque autem ex parte aliorum, qui ex hoc scandalizarentur.""";
    content_hash "sha256:ea072f982d918689adfcbe3e9096ee8e7be5f75850634f5fd831c952eba9afa9";
}

fragment ST_II_II_Q149_A3_AD1 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-3/reply/1";
    text la official """[44961] IIª-IIae, q. 149 a. 3 ad 1 Ad primum ergo dicendum quod sapientia potest haberi dupliciter. Uno modo, secundum modum communem, prout sufficit ad salutem. Et sic non requiritur ad sapientiam habendam quod aliquis a vino omnino abstineat, sed quod abstineat ab immoderato usu vini. Alio modo, secundum quendam perfectionis gradum. Et sic requiritur in aliquibus, ad perfecte sapientiam percipiendam, quod omnino a vino abstineant, secundum conditiones quarundam personarum et locorum.""";
    content_hash "sha256:0f695557fbc4a44021d7324e8eb9ee0a09d8d6996c6f5017abb99db51211573e";
}

fragment ST_II_II_Q149_A3_AD2 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-3/reply/2";
    text la official """[44962] IIª-IIae, q. 149 a. 3 ad 2 Ad secundum dicendum quod apostolus non simpliciter dicit bonum esse abstinere a vino, sed in casu in quo ex hoc aliqui scandalizantur.""";
    content_hash "sha256:6ced73eee2fec00310cae10cfc6ac4defb6fda27c6b6b4e69579baaac6b483c4";
}

fragment ST_II_II_Q149_A3_AD3 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-3/reply/3";
    text la official """[44963] IIª-IIae, q. 149 a. 3 ad 3 Ad tertium dicendum quod Christus retrahit nos a quibusdam sicut omnino illicitis, a quibusdam vero sicut ab impedimentis perfectionis. Et hoc modo retrahit aliquos a vino studio perfectionis, sicut et a divitiis et aliis huiusmodi.""";
    content_hash "sha256:0a1b7f494bbc30e93cdd4b2017b1e83435237b9be0fdc086a3afab2cdc11ba1c";
}

fragment ST_II_II_Q149_A4_ARG1 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-4/objection/1";
    text la official """[44964] IIª-IIae, q. 149 a. 4 arg. 1 Ad quartum sic proceditur. Videtur quod sobrietas magis requiratur in maioribus personis. Senectus enim excellentiam quandam homini praestat, unde et senibus reverentia et honor debetur, secundum illud Levit. XIX, coram cano capite consurge, et honora personam senis. Sed apostolus specialiter senes dicit esse ad sobrietatem exhortandos, secundum illud Tit. II, senes, ut sobrii sint. Ergo sobrietas maxime requiritur in excellentioribus personis.""";
    content_hash "sha256:a3aa20335be44c78f478c4e8fd63778183deb6f113e6fad88a4c371a0aea71f1";
}

fragment ST_II_II_Q149_A4_ARG2 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-4/objection/2";
    text la official """[44965] IIª-IIae, q. 149 a. 4 arg. 2 Praeterea, episcopus in Ecclesia excellentissimum gradum habet. Cui per apostolum indicitur sobrietas, secundum illud I ad Tim. III, oportet episcopum irreprehensibilem esse, unius uxoris virum, sobrium, prudentem, et cetera. Ergo sobrietas maxime requiritur in personis excellentibus.""";
    content_hash "sha256:a0a7de12fde6bd3e2ccc92c0e2c1d4594fc99d9acd13d17e0a5d096ad5e2a148";
}

fragment ST_II_II_Q149_A4_ARG3 in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-4/objection/3";
    text la official """[44966] IIª-IIae, q. 149 a. 4 arg. 3 Praeterea, sobrietas importat abstinentiam a vino. Sed vinum interdicitur regibus, qui tenent summum locum in rebus humanis, conceditur autem his qui sunt in statu deiectionis, secundum illud Prov. XXXI, noli regibus dare vinum; et postea subdit, date siceram moerentibus, et vinum his qui amaro animo sunt. Ergo sobrietas magis requiritur in excellentioribus personis.""";
    content_hash "sha256:8354c67351fb1e900f853a90a1b069a06b07a15062726d8da5b231638bb5837a";
}

fragment ST_II_II_Q149_A4_SC in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-4/sed-contra";
    text la official """[44967] IIª-IIae, q. 149 a. 4 s. c. Sed contra est quod apostolus, I ad Tim. III, dicit, mulieres similiter pudicas, sobrias, et cetera. Et Tit. II dicitur, iuvenes similiter hortare ut sobrii sint.""";
    content_hash "sha256:c1597b371b22d269d0186da6b7f6ff696fd6a2d0c00d14ea5e354a17e89fd11e";
}

fragment ST_II_II_Q149_A4_RESP in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-4/respondeo";
    text la official """[44968] IIª-IIae, q. 149 a. 4 co. Respondeo dicendum quod virtus habet habitudinem ad duo, uno quidem modo, ad contraria vitia quae excludit, et concupiscentias quas refrenat; alio modo, ad finem in quem perducit. Sic igitur aliqua virtus magis requiritur in aliquibus duplici ratione. Uno modo, quia in eis est maior pronitas ad concupiscentias quas oportet per virtutem refrenari, et ad vitia quae per virtutem tolluntur. Et secundum hoc, sobrietas maxime requiritur in iuvenibus et mulieribus, quia in iuvenibus viget concupiscentia delectabilis, propter fervorem aetatis; in mulieribus autem non est sufficiens robur mentis ad hoc quod concupiscentiis resistant unde, secundum maximum Valerium, mulieres apud Romanos antiquitus non bibebant vinum. Alio vero modo sobrietas magis requiritur in aliquibus utpote magis necessaria ad propriam operationem ipsorum. Vinum autem immoderate sumptum praecipue impedit usum rationis. Et ideo senibus, in quibus ratio debet vigere ad aliorum eruditionem; et episcopis, seu quibuslibet Ecclesiae ministris, qui mente devota debent spiritualibus officiis insistere; et regibus, qui per sapientiam debent populum subditum gubernare, specialiter sobrietas indicitur.""";
    content_hash "sha256:c27790c4454d55bf663c6363c887800acd60ae6af94fbf678c9d386693d89534";
}

fragment ST_II_II_Q149_A4_AD_ALL in LEONINA_CT_Q149 {
    kind paragraph;
    locator "section/149-4/reply/all";
    text la official """[44969] IIª-IIae, q. 149 a. 4 ad arg. Et per hoc patet responsio ad obiecta.""";
    content_hash "sha256:39e3e0eef2b1f8960bd50e1b5bdba4edf78b5497f1302945d1e556ea08a12f81";
}

