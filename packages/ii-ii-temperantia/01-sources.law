fragment ST_II_II_Q170_PR in LEONINA_CT_Q170 {
    kind paragraph;
    locator "question/170/prooemium";
    text la official """[45768] IIª-IIae, q. 170 pr. Deinde considerandum est de praeceptis temperantiae. Et primo, de praeceptis ipsius temperantiae. Secundo, de praeceptis partium eius.""";
    content_hash "sha256:07de6cd1b78d2df3529692da9036bdd48825e13306f91e91767020235e8989ad";
}

fragment ST_II_II_Q170_A1_ARG1 in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-1/objection/1";
    text la official """[45769] IIª-IIae, q. 170 a. 1 arg. 1 Ad primum sic proceditur. Videtur quod praecepta temperantiae inconvenienter in lege divina tradantur. Fortitudo enim est potior virtus quam temperantia, ut supra dictum est. Sed nullum praeceptum fortitudinis ponitur inter praecepta Decalogi, quae sunt potiora legis praecepta. Ergo inconvenienter inter praecepta Decalogi ponitur prohibitio adulterii, quod contrariatur temperantiae, ut ex supra dictis patet.""";
    content_hash "sha256:feed48d75adf8c256b010f488e6bea7c1f3114789bd52d1f8b9650f14551cb1b";
}

fragment ST_II_II_Q170_A1_ARG2 in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-1/objection/2";
    text la official """[45770] IIª-IIae, q. 170 a. 1 arg. 2 Praeterea, temperantia non solum est circa venerea, sed etiam circa delectationem ciborum et potuum. Sed inter praecepta Decalogi non prohibetur aliquod vitium pertinens ad delectationem ciborum et potuum, neque etiam pertinens ad aliquam aliam speciem luxuriae. Ergo neque etiam debet poni aliquod praeceptum prohibens adulterium, quod pertinet ad delectationem venereorum.""";
    content_hash "sha256:86e0eef20f0db9d27dbe1dbbfdf91b11f3f4b828ccd3f904ab35859efe452328";
}

fragment ST_II_II_Q170_A1_ARG3 in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-1/objection/3";
    text la official """[45771] IIª-IIae, q. 170 a. 1 arg. 3 Praeterea, principalius est in intentione legislatoris inducere ad virtutes quam vitia prohibere, ad hoc enim vitia prohibentur, ut virtutum impedimenta tollantur. Sed praecepta Decalogi sunt principalia in lege divina. Ergo inter praecepta Decalogi magis debuit poni praeceptum aliquod affirmativum directe inducens ad virtutem temperantiae, quam praeceptum negativum prohibens adulterium, quod ei directe opponitur.""";
    content_hash "sha256:31901363b0b49eef31e0dcd329332134bb80295a5282f8c3845cebb2dc667872";
}

fragment ST_II_II_Q170_A1_SC in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-1/sed-contra";
    text la official """[45772] IIª-IIae, q. 170 a. 1 s. c. In contrarium est auctoritas Scripturae.""";
    content_hash "sha256:9e3bc2f5d7b9a96336e48addd0b7265ef9637a134fda890c3f536b4883173a2b";
}

fragment ST_II_II_Q170_A1_RESP in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-1/respondeo";
    text la official """[45773] IIª-IIae, q. 170 a. 1 co. Respondeo dicendum quod, sicut apostolus dicit, I ad Tim. I, finis praecepti caritas est, ad quam duobus praeceptis inducimur pertinentibus ad dilectionem Dei et proximi. Et ideo illa praecepta in Decalogo ponuntur quae directius ordinantur ad dilectionem Dei et proximi. Inter vitia autem temperantiae opposita, maxime dilectioni proximi videtur opponi adulterium, per quod aliquis usurpat sibi rem alienam, abutendo scilicet uxore proximi. Et ideo inter praecepta Decalogi praecipue prohibetur adulterium, non solum secundum quod opere exercetur, sed etiam secundum quod corde concupiscitur.""";
    content_hash "sha256:ca5deec566fed664457132b90022d6cc7cc6722b8dc965edd9cf410eb426a093";
}

fragment ST_II_II_Q170_A1_AD1 in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-1/reply/1";
    text la official """[45774] IIª-IIae, q. 170 a. 1 ad 1 Ad primum ergo dicendum quod inter species vitiorum quae opponuntur fortitudini, nulla est quae ita directe contrarietur dilectioni proximi sicut adulterium, quod est species luxuriae, quae temperantiae contrariatur. Et tamen vitium audaciae, quod opponitur fortitudini, quandoque solet esse causa homicidii, quod inter praecepta Decalogi prohibetur, dicitur enim Eccli. VIII, cum audace non eas in via, ne forte gravet mala sua in te.""";
    content_hash "sha256:26dd82decc1d1aee0e629ea620104ffb5dd5e04a8fe4d83963446e3593511ed9";
}

fragment ST_II_II_Q170_A1_AD2 in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-1/reply/2";
    text la official """[45775] IIª-IIae, q. 170 a. 1 ad 2 Ad secundum dicendum quod gula directe non opponitur dilectioni proximi, sicut adulterium, neque etiam aliqua alia species luxuriae. Non enim tanta fit iniuria patri per stuprum virginis, quae non est eius connubio deputata, quanta fit iniuria viro per adulterium, cuius corporis potestatem ipse habet, non uxor.""";
    content_hash "sha256:fbdfdd6657a53ef91439ba70b0fac4b7bb27bc98ef7da0cb93e49e101853752e";
}

fragment ST_II_II_Q170_A1_AD3 in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-1/reply/3";
    text la official """[45776] IIª-IIae, q. 170 a. 1 ad 3 Ad tertium dicendum quod praecepta Decalogi, ut supra dictum est, sunt quaedam universalia divinae legis principia, unde oportet ea esse communia. Non potuerunt autem aliqua praecepta communia affirmativa de temperantia dari, quia usus eius variatur secundum diversa tempora, sicut Augustinus dicit, in libro de bono Coniug., et secundum diversas hominum leges et consuetudines.""";
    content_hash "sha256:55cc5fd4890e8a97cfc41151e940ed2e91b027feeec3ba36faaf4a66b91c0ef9";
}

fragment ST_II_II_Q170_A2_ARG1 in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-2/objection/1";
    text la official """[45777] IIª-IIae, q. 170 a. 2 arg. 1 Ad secundum sic proceditur. Videtur quod inconvenienter tradantur in divina lege praecepta de virtutibus annexis temperantiae. Praecepta enim Decalogi, ut dictum est, sunt quaedam universalia principia totius legis divinae. Sed superbia est initium omnis peccati, ut dicitur Eccli. X. Ergo inter praecepta Decalogi debuit aliquod poni prohibitivum superbiae.""";
    content_hash "sha256:360918c92937b2c66e6abbf0d204701bad6e49789ed7b41c0d9b823b447f5043";
}

fragment ST_II_II_Q170_A2_ARG2 in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-2/objection/2";
    text la official """[45778] IIª-IIae, q. 170 a. 2 arg. 2 Praeterea, illa praecepta maxime debent in Decalogo poni per quae homines maxime inclinantur ad legis impletionem, quia ista videntur esse principalia. Sed per humilitatem, per quam homo Deo subiicitur, maxime videtur homo disponi ad observantiam divinae legis, unde obedientia inter gradus humilitatis computatur, ut supra habitum est. Et idem etiam videtur esse dicendum de mansuetudine, per quam fit ut homo divinae Scripturae non contradicat, ut Augustinus dicit, in II de Doct. Christ. Ergo videtur quod de humilitate et mansuetudine aliqua praecepta in Decalogo poni debuerunt.""";
    content_hash "sha256:e8d616ea1e87d121f529f533121a07f555861623a1b2f433f39a02964dd05630";
}

fragment ST_II_II_Q170_A2_ARG3 in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-2/objection/3";
    text la official """[45779] IIª-IIae, q. 170 a. 2 arg. 3 Praeterea, dictum est quod adulterium in Decalogo prohibetur quia contrariatur dilectioni proximi. Sed etiam inordinatio exteriorum motuum, quae contrariatur modestiae, dilectioni proximi opponitur, unde Augustinus dicit, in regula, in omnibus motibus vestris nihil fiat quod cuiusquam offendat aspectum. Ergo videtur quod etiam huiusmodi inordinatio debuit prohiberi per aliquod praeceptum Decalogi.""";
    content_hash "sha256:a54ccb5568583ce8f3b113068b7885ccf9d957551bc5ad94816595a0321301c2";
}

fragment ST_II_II_Q170_A2_SC in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-2/sed-contra";
    text la official """[45780] IIª-IIae, q. 170 a. 2 s. c. In contrarium sufficit auctoritas Scripturae.""";
    content_hash "sha256:b9095f9683b27d36c1caa41f25a928c894df0a9278c141e3316493861b7a6f89";
}

fragment ST_II_II_Q170_A2_RESP in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-2/respondeo";
    text la official """[45781] IIª-IIae, q. 170 a. 2 co. Respondeo dicendum quod virtutes temperantiae annexae dupliciter considerari possunt, uno modo, secundum se; alio modo, secundum suos effectus. Secundum se quidem, non habent directam habitudinem ad dilectionem Dei vel proximi, sed magis respiciunt quandam moderationem eorum quae ad ipsum hominem pertinent. Quantum autem ad effectus suos, possunt respicere dilectionem Dei vel proximi. Et secundum hoc, aliqua praecepta in Decalogo ponuntur pertinentia ad prohibendum effectus vitiorum oppositorum temperantiae partibus, sicut ex ira, quae opponitur mansuetudini, procedit interdum aliquis ad homicidium, quod in Decalogo prohibetur, vel ad subtrahendum debitum honorem parentibus. Quod etiam potest ex superbia provenire, ex qua etiam multi transgrediuntur praecepta primae tabulae.""";
    content_hash "sha256:54297a18ee5729a6b33b80d52059ceca5f5ccc0429d7110716f5368b42527295";
}

fragment ST_II_II_Q170_A2_AD1 in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-2/reply/1";
    text la official """[45782] IIª-IIae, q. 170 a. 2 ad 1 Ad primum ergo dicendum quod superbia est initium peccati, sed latens in corde, cuius etiam inordinatio non perpenditur communiter ab omnibus. Unde eius prohibitio non debuit poni inter praecepta Decalogi, quae sunt sicut prima principia per se nota.""";
    content_hash "sha256:15c152c2e5883fbbda779edd64ba48267d82738e2c4c49c9b18062671484b422";
}

fragment ST_II_II_Q170_A2_AD2 in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-2/reply/2";
    text la official """[45783] IIª-IIae, q. 170 a. 2 ad 2 Ad secundum dicendum quod praecepta quae inducunt ad observantiam legis, praesupponunt iam legem. Unde non possunt esse prima legis praecepta, ut in Decalogo ponantur.""";
    content_hash "sha256:1cbdb72f2a6c3d06f8ff5afe503a4bfa3ca9f38a3aebf8a99320044431359c0f";
}

fragment ST_II_II_Q170_A2_AD3 in LEONINA_CT_Q170 {
    kind paragraph;
    locator "section/170-2/reply/3";
    text la official """[45784] IIª-IIae, q. 170 a. 2 ad 3 Ad tertium dicendum quod inordinatio exteriorum motuum non pertinet ad offensam proximi secundum ipsam speciem actus, sicut homicidium, adulterium et furtum, quae in Decalogo prohibentur, sed solum secundum quod sunt signa interioris inordinationis, ut supra dictum est.""";
    content_hash "sha256:01b7aa24b44f34523cd21e74afb8b9cba0b2429c8c5de2d1231c1f9bb2b89bed";
}
