    label ru unofficial "Editio Leonina в электронной передаче Corpus Thomisticum, II-II q. 18";
}

publication ST_TEXT_Q18 of LEONINA_CT_Q18 {
    media_type "text/plain; charset=utf-8";
    uri "https://www.corpusthomisticum.org/sth3017.html";
    retrieved_at @2026-09-18T21:00:00Z;
    content_hash "sha256:f3d8b757b91cc968039a2af2798ab60148430aece775655a909823118a032a9c";
    local_path "sources/summa-theologiae-ii-ii-spe/q18.la.txt";
}

fragment ST_II_II_Q18_PR in LEONINA_CT_Q18 {
    kind paragraph;
    locator "question/18/prooemium";
    text la official """Deinde considerandum est de subiecto spei. Et circa hoc quaeruntur quatuor. Primo, utrum virtus spei sit in voluntate sicut in subiecto. Secundo, utrum sit in beatis. Tertio, utrum sit in damnatis. Quarto, utrum in viatoribus habeat certitudinem.""";
    content_hash "sha256:0c34d9e4a97dbfb9d09be819fceb3a64292cdb97385b0b6d09a1f9b32f6aef92";
}

fragment ST_II_II_Q18_A1_ARG1 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-1/objection/1";
    text la official """Ad primum sic proceditur. Videtur quod spes non sit in voluntate sicut in subiecto. Spei enim obiectum est bonum arduum, ut supra dictum est. Arduum autem non est obiectum voluntatis, sed irascibilis. Ergo spes non est in voluntate, sed in irascibili.""";
    content_hash "sha256:72a43829d53caf5a303e898949532ee9877e010cf55049da81075ed144fd5b5f";
}

fragment ST_II_II_Q18_A1_ARG2 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-1/objection/2";
    text la official """Praeterea, ad id ad quod unum sufficit, superflue apponitur aliud. Sed ad perficiendum potentiam voluntatis sufficit caritas, quae est perfectissima virtutum. Ergo spes non est in voluntate.""";
    content_hash "sha256:ce5de97ecb7eff1b814e5a555b558820a56982b30e9bdc0cf75af4b7359f4725";
}

fragment ST_II_II_Q18_A1_ARG3 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-1/objection/3";
    text la official """Praeterea, una potentia non potest simul esse in duobus actibus, sicut intellectus non potest simul multa intelligere. Sed actus spei simul esse potest cum actu caritatis. Cum ergo actus caritatis manifeste pertineat ad voluntatem, actus spei non pertinet ad ipsam. Sic ergo spes non est in voluntate.""";
    content_hash "sha256:2119ae71f6295b65f22fc498e1cc21cc6ead7aa8e5b51e3a76a915be3892ffce";
}

fragment ST_II_II_Q18_A1_SC in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-1/sed-contra";
    text la official """Sed contra, anima non est capax Dei nisi secundum mentem; in qua est memoria, intelligentia et voluntas, ut patet per Augustinum, in libro de Trin. Sed spes est virtus theologica habens Deum pro obiecto. Cum igitur non sit neque in memoria neque in intelligentia, quae pertinent ad vim cognoscitivam, relinquitur quod sit in voluntate sicut in subiecto.""";
    content_hash "sha256:81216f3fdaf1799898d233af8630b61d7792b687101717631fdcc2e1b814dcd1";
}

fragment ST_II_II_Q18_A1_RESP in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-1/respondeo";
    text la official """Respondeo dicendum quod, sicut ex praedictis patet, habitus per actus cognoscuntur. Actus autem spei est quidam motus appetitivae partis, cum sit eius obiectum bonum. Cum autem sit duplex appetitus in homine, scilicet appetitus sensitivus, qui dividitur per irascibilem et concupiscibilem, et appetitus intellectivus, qui dicitur voluntas, ut in primo habitum est; similes motus qui sunt in appetitu inferiori cum passione, in superiori sunt sine passione, ut ex supradictis patet. Actus autem virtutis spei non potest pertinere ad appetitum sensitivum, quia bonum quod est obiectum principale huius virtutis non est aliquod bonum sensibile, sed bonum divinum. Et ideo spes est in appetitu superiori, qui dicitur voluntas, sicut in subiecto, non autem in appetitu inferiori, ad quem pertinet irascibilis.""";
    content_hash "sha256:bdde5c572f4f8f39ef491a5930c7df38b12ff96b7c240625812c4c18cf743a3a";
}

fragment ST_II_II_Q18_A1_AD1 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-1/reply/1";
    text la official """Ad primum ergo dicendum quod irascibilis obiectum est arduum sensibile. Obiectum autem virtutis spei est arduum intelligibile; vel potius supra intellectum existens.""";
    content_hash "sha256:ba4496083a58e69f60ddadd1f399a2cfef157764aaa597984c55d0e392b37200";
}

fragment ST_II_II_Q18_A1_AD2 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-1/reply/2";
    text la official """Ad secundum dicendum quod caritas sufficienter perficit voluntatem quantum ad unum actum, qui est diligere. Requiritur autem alia virtus ad perficiendum ipsam secundum alium actum eius, qui est sperare.""";
    content_hash "sha256:98d2994075661096708c1748a4628797d51c97fc46dfd42e44429cb193dbd36c";
}

fragment ST_II_II_Q18_A1_AD3 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-1/reply/3";
    text la official """Ad tertium dicendum quod motus spei et motus caritatis habent ordinem ad invicem, ut ex supradictis patet. Unde nihil prohibet utrumque motum simul esse unius potentiae. Sicut et intellectus potest simul multa intelligere ad invicem ordinata, ut in primo habitum est.""";
    content_hash "sha256:6b1c870f24ab746b880c2b6858d045da4c1be9094b3930e54ad2a70c62e505b7";
}

fragment ST_II_II_Q18_A2_ARG1 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-2/objection/1";
    text la official """Ad secundum sic proceditur. Videtur quod spes sit in beatis. Christus enim a principio suae conceptionis fuit perfectus comprehensor. Sed ipse habuit spem, cum ex eius persona dicatur in Psalm., in te, domine, speravi, ut Glossa exponit. Ergo in beatis potest esse spes.""";
    content_hash "sha256:6f6737fffd1ab85d535f965038abe23508a6b83ff5a48eb2fd6e39cdfb754518";
}

fragment ST_II_II_Q18_A2_ARG2 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-2/objection/2";
    text la official """Praeterea, sicut adeptio beatitudinis est quoddam bonum arduum, ita etiam eius continuatio. Sed homines antequam beatitudinem adipiscantur habent spem de beatitudinis adeptione. Ergo postquam sunt beatitudinem adepti, possunt sperare beatitudinis continuationem.""";
    content_hash "sha256:56d6360470346928b04ea5052dc6ff8b161e87d27cc02baa6864fe3afdc0599e";
}

fragment ST_II_II_Q18_A2_ARG3 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-2/objection/3";
    text la official """Praeterea, per virtutem spei potest aliquis beatitudinem sperare non solum sibi sed etiam aliis, ut supra dictum est. Sed beati qui sunt in patria sperant beatitudinem aliis, alioquin non rogarent pro eis. Ergo in beatis potest esse spes.""";
    content_hash "sha256:368883b16d3a370c22d2ccb6f32dcc2ddda9e915593d19c5641ebb89d16ea616";
}

fragment ST_II_II_Q18_A2_ARG4 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-2/objection/4";
    text la official """Praeterea, ad beatitudinem sanctorum pertinet non solum gloria animae sed etiam gloria corporis. Sed animae sanctorum qui sunt in patria expectant adhuc gloriam corporis, ut patet Apoc. VI, et XII super Gen. ad Litt. Ergo spes potest esse in beatis.""";
    content_hash "sha256:ae0ae6b1b9f2b3ed848e8155dd96c1169ce744aaee47b6c730284cf8cb223c26";
}

fragment ST_II_II_Q18_A2_SC in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-2/sed-contra";
    text la official """Sed contra est quod apostolus dicit, ad Rom. VIII, quod videt quis, quid sperat? Sed beati fruuntur Dei visione. Ergo in eis spes locum non habet.""";
    content_hash "sha256:94b3edc81300812bab1390a2fdd4366cab4758c338f065f6852851f02410f0c2";
}

fragment ST_II_II_Q18_A2_RESP in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-2/respondeo";
    text la official """Respondeo dicendum quod, subtracto eo quod dat speciem rei, solvitur species, et res non potest eadem remanere, sicut remota forma corporis naturalis, non remanet idem secundum speciem. Spes autem recipit speciem a suo obiecto principali, sicut et ceterae virtutes, ut ex supradictis patet. Obiectum autem principale eius est beatitudo aeterna secundum quod est possibilis haberi ex auxilio divino, ut supra dictum est. Quia ergo bonum arduum possibile non cadit sub ratione spei nisi secundum quod est futurum, ideo, cum beatitudo iam non fuerit futura sed praesens, non potest ibi esse virtus spei. Et ideo spes, sicut et fides, evacuatur in patria, et neutrum eorum in beatis esse potest.""";
    content_hash "sha256:60e1d57c6e409a32b8aa39e0aef4316c406b7192835b1f4894b023b536723147";
}

fragment ST_II_II_Q18_A2_AD1 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-2/reply/1";
    text la official """Ad primum ergo dicendum quod Christus, etsi esset comprehensor, et per consequens beatus, quantum ad divinam fruitionem; erat tamen simul viator quantum ad passibilitatem naturae, quam adhuc gerebat. Et ideo gloriam impassibilitatis et immortalitatis sperare poterat. Non tamen ita quod haberet virtutem spei, quae non respicit gloriam corporis sicut principale obiectum, sed potius fruitionem divinam.""";
    content_hash "sha256:8b1492a91b0501119cb88433cd7703c4c8ee1e7b9a725a088c7eda0ac207d4b0";
}

fragment ST_II_II_Q18_A2_AD2 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-2/reply/2";
    text la official """Ad secundum dicendum quod beatitudo sanctorum dicitur vita aeterna, quia per hoc quod Deo fruuntur, efficiuntur quodammodo participes aeternitatis divinae, quae excedit omne tempus. Et ita continuatio beatitudinis non diversificatur per praesens, praeteritum et futurum. Et ideo beati non habent spem de continuatione beatitudinis, sed habent ipsam rem, quia non est ibi ratio futuri.""";
    content_hash "sha256:a9177bc0552220ad93f1422d2e9cd5b58f68a0a44d8173b0905488937c6aeb3f";
}

fragment ST_II_II_Q18_A2_AD3 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-2/reply/3";
    text la official """Ad tertium dicendum quod, durante virtute spei, eadem spe aliquis sperat beatitudinem sibi et aliis. Sed evacuata spe in beatis qua sperabant sibi beatitudinem, sperant quidem aliis beatitudinem, sed non virtute spei, sed magis ex amore caritatis. Sicut etiam qui habet caritatem Dei eadem caritate diligit proximum, et tamen aliquis potest diligere proximum non habens virtutem caritatis, alio quodam amore.""";
    content_hash "sha256:c6adf686108cf0b54f547de2a7232a06b589eeb04a184bd9b91e433b71ce61c5";
}

fragment ST_II_II_Q18_A2_AD4 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-2/reply/4";
    text la official """Ad quartum dicendum quod, cum spes sit virtus theologica habens Deum pro obiecto, principale obiectum spei est gloria animae, quae in fruitione divina consistit, non autem gloria corporis. Gloria etiam corporis, etsi habeat rationem ardui per comparationem ad naturam humanam, non habet tamen rationem ardui habenti gloriam animae. Tum quia gloria corporis est minimum quiddam in comparatione ad gloriam animae. Tum etiam quia habens gloriam animae habet iam sufficienter causam gloriae corporis.""";
    content_hash "sha256:4000741105e4609959b11a265af6be62f285fbe709bc23ec753f89c6858510dd";
}

fragment ST_II_II_Q18_A3_ARG1 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-3/objection/1";
    text la official """Ad tertium sic proceditur. Videtur quod in damnatis sit spes. Diabolus enim est et damnatus et princeps damnatorum, secundum illud Matth. XXV, ite, maledicti, in ignem aeternum, qui paratus est Diabolo et Angelis eius. Sed Diabolus habet spem, secundum illud Iob XL, ecce spes eius frustrabitur eum. Ergo videtur quod damnati habeant spem.""";
    content_hash "sha256:90f0dad8634b9208a272b21e41e06b59e617990e03cb75936106b95eaa3745bf";
}

fragment ST_II_II_Q18_A3_ARG2 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-3/objection/2";
    text la official """Praeterea, sicut fides potest esse formata et informis, ita et spes. Sed fides informis potest esse in Daemonibus et damnatis, secundum illud Iac. II, Daemones credunt et contremiscunt. Ergo videtur quod etiam spes informis potest esse in damnatis.""";
    content_hash "sha256:b9b711783c4146914a9c237bbf9df2fd1410d727b3202ab160a40215d65fb69e";
}

fragment ST_II_II_Q18_A3_ARG3 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-3/objection/3";
    text la official """Praeterea, nulli hominum post mortem accrescit meritum vel demeritum quod in vita non habuit, secundum illud Eccle. XI, si ceciderit lignum ad Austrum aut ad Aquilonem, in quocumque loco ceciderit ibi erit. Sed multi qui damnabuntur habuerunt in hac vita spem, nunquam desperantes. Ergo etiam in futura vita spem habebunt.""";
    content_hash "sha256:846be65c97332323fb3d736d22bbcaa85e7d933a2d467d46322bc8325556eb02";
}

fragment ST_II_II_Q18_A3_SC in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-3/sed-contra";
    text la official """Sed contra est quod spes causat gaudium, secundum illud Rom. XII, spe gaudentes. Sed damnati non sunt in gaudio, sed in dolore et luctu, secundum illud Isaiae LXV, servi mei laudabunt prae exultatione cordis, et vos clamabitis prae dolore cordis et prae contritione spiritus ululabitis. Ergo spes non est in damnatis.""";
    content_hash "sha256:9f171ed79325898444717427ee435a707761f32539c77ae20f8c140db0550f14";
}

fragment ST_II_II_Q18_A3_RESP in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-3/respondeo";
    text la official """Respondeo dicendum quod sicut de ratione beatitudinis est ut in ea quietetur voluntas, ita de ratione poenae est ut id quod pro poena infligitur voluntati repugnet. Non potest autem voluntatem quietare, vel ei repugnare, quod ignoratur. Et ideo Augustinus dicit, super Gen. ad Litt., quod Angeli perfecte beati esse non potuerunt in primo statu ante confirmationem, vel miseri ante lapsum, cum non essent praescii sui eventus, requiritur enim ad veram et perfectam beatitudinem ut aliquis certus sit de suae beatitudinis perpetuitate; alioquin voluntas non quietaretur. Similiter etiam, cum perpetuitas damnationis pertineat ad poenam damnatorum, non vere haberet rationem poenae nisi voluntati repugnaret, quod esse non posset si perpetuitatem suae damnationis ignorarent. Et ideo ad conditionem miseriae damnatorum pertinet ut ipsi sciant quod nullo modo possunt damnationem evadere et ad beatitudinem pervenire, unde dicitur Iob XV, non credit quod reverti possit de tenebris ad lucem. Unde patet quod non possunt apprehendere beatitudinem ut bonum possibile, sicut nec beati ut bonum futurum. Et ideo neque in beatis neque in damnatis est spes. Sed in viatoribus sive sint in vita ista sive in Purgatorio, potest esse spes, quia utrobique apprehendunt beatitudinem ut futurum possibile.""";
    content_hash "sha256:e4b0ad4006f14a2ea342cd75ef26ca5508e07a500aa65b71e8777af6639cfbc1";
}

fragment ST_II_II_Q18_A3_AD1 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-3/reply/1";
    text la official """Ad primum ergo dicendum quod, sicut Gregorius dicit, XXXIII Moral., hoc dicitur de Diabolo secundum membra eius, quorum spes annullabitur. Vel si intelligatur de ipso Diabolo, potest referri ad spem qua sperat se de sanctis victoriam obtinere, secundum illud quod supra praemiserat, habet fiduciam quod Iordanis influat in os eius. Haec autem non est spes de qua loquimur.""";
    content_hash "sha256:880f3c9b36f8c86097a3d4efe6f26c63a365a9f9c9491f036f07605afb4a65f6";
}

fragment ST_II_II_Q18_A3_AD2 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-3/reply/2";
    text la official """Ad secundum dicendum quod, sicut Augustinus dicit, in Enchirid., fides est et malarum rerum et bonarum, et praeteritarum et praesentium et futurarum, et suarum et alienarum, sed spes non est nisi rerum bonarum futurarum ad se pertinentium. Et ideo magis potest esse fides informis in damnatis quam spes, quia bona divina non sunt eis futura possibilia, sed sunt eis absentia.""";
    content_hash "sha256:a08bee1a0b258285cdeecd72e072206e3b9b69819b991b58c66de17245a1e7f2";
}

fragment ST_II_II_Q18_A3_AD3 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-3/reply/3";
    text la official """Ad tertium dicendum quod defectus spei in damnatis non variat demeritum, sicut nec evacuatio spei in beatis auget meritum, sed utrumque contingit propter mutationem status.""";
    content_hash "sha256:a775c4c8a4b233eedccd1485def4afe3920ccf542844d5ea39eaa619211fe0b4";
}

fragment ST_II_II_Q18_A4_ARG1 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-4/objection/1";
    text la official """Ad quartum sic proceditur. Videtur quod spes viatorum non habeat certitudinem. Spes enim est in voluntate sicut in subiecto. Sed certitudo non pertinet ad voluntatem, sed ad intellectum. Ergo spes non habet certitudinem.""";
    content_hash "sha256:a329ac3afba6e5981ce6b02dbb3fea0ae063a7e42e357214ab5defa48975da6e";
}

fragment ST_II_II_Q18_A4_ARG2 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-4/objection/2";
    text la official """Praeterea, spes ex gratia et meritis provenit, ut supra dictum est. Sed in hac vita scire per certitudinem non possumus quod gratiam habeamus, ut supra dictum est. Ergo spes viatorum non habet certitudinem.""";
    content_hash "sha256:6e470d309f688aa9b721cc556275faff68d9104430be599ca0724458bcf9b536";
}

fragment ST_II_II_Q18_A4_ARG3 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-4/objection/3";
    text la official """Praeterea, certitudo esse non potest de eo quod potest deficere. Sed multi viatores habentes spem deficiunt a consecutione beatitudinis. Ergo spes viatorum non habet certitudinem.""";
    content_hash "sha256:7718d19aff1400551224db1c56d403e586ef88d00fc84d58744bdf6612ee9622";
}

fragment ST_II_II_Q18_A4_SC in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-4/sed-contra";
    text la official """Sed contra est quod spes est certa expectatio futurae beatitudinis, sicut Magister dicit, XXVI dist. III Sent. Quod potest accipi ex hoc quod dicitur II ad Tim. I, scio cui credidi, et certus sum quia potens est depositum meum servare.""";
    content_hash "sha256:b9d39fe336ee6659544dcd97c472cbefa9dcc24b51bfa7ddb237e35522e3ab75";
}

fragment ST_II_II_Q18_A4_RESP in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-4/respondeo";
    text la official """Respondeo dicendum quod certitudo invenitur in aliquo dupliciter, scilicet essentialiter, et participative. Essentialiter quidem invenitur in vi cognoscitiva, participative autem in omni eo quod a vi cognoscitiva movetur infallibiliter ad finem suum; secundum quem modum dicitur quod natura certitudinaliter operatur, tanquam mota ab intellectu divino certitudinaliter movente unumquodque ad suum finem. Et per hunc etiam modum virtutes morales certius arte dicuntur operari, inquantum per modum naturae moventur a ratione ad suos actus. Et sic etiam spes certitudinaliter tendit in suum finem, quasi participans certitudinem a fide, quae est in vi cognoscitiva.""";
    content_hash "sha256:ef7a52a45f62531692448b8a93b9bfb64eb1dca9d602c7a5d81c4d8e989142a6";
}

fragment ST_II_II_Q18_A4_AD1 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-4/reply/1";
    text la official """Unde patet responsio ad primum.""";
    content_hash "sha256:8964342f63ab4ecfde919f8188eaf459f89f13bb7fdb9c63f0f2691223ba6972";
}

fragment ST_II_II_Q18_A4_AD2 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-4/reply/2";
    text la official """Ad secundum dicendum quod spes non innititur principaliter gratiae iam habitae, sed divinae omnipotentiae et misericordiae, per quam etiam qui gratiam non habet eam consequi potest, ut sic ad vitam aeternam perveniat. De omnipotentia autem Dei et eius misericordia certus est quicumque fidem habet.""";
    content_hash "sha256:e94e2a853c3022d37ad2e73685c76ed836dcb545b80936c3f68ae2268fba9015";
}

fragment ST_II_II_Q18_A4_AD3 in LEONINA_CT_Q18 {
    kind paragraph;
    locator "section/18-4/reply/3";
    text la official """Ad tertium dicendum quod hoc quod aliqui habentes spem deficiant a consecutione beatitudinis, contingit ex defectu liberi arbitrii ponentis obstaculum peccati, non autem ex defectu divinae omnipotentiae vel misericordiae, cui spes innititur. Unde hoc non praeiudicat certitudini spei.""";
    content_hash "sha256:5a9d8842266367a45273a78d0f49abb93d44e1812acbb400fab8c7840fbcd4a5";
}

edition LEONINA_CT_Q19 of SUMMA_THEOLOGIAE_II_II_17_22 {
    language la;
    officiality unofficial;
