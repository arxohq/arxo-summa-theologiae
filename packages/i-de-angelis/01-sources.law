publication ST_TEXT_Q57 of LEONINA_CT_Q57 {
    media_type "text/plain; charset=utf-8";
    uri "https://www.corpusthomisticum.org/sth1050.html";
    retrieved_at @2026-09-18T21:00:00Z;
    content_hash "sha256:9349d4bdc74ca6daa73ed5d64748ed1458be7f3229c9c353b0a503f86863ad77";
