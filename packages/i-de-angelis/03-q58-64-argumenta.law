    label la official "Videtur quod, obiectio 2, I q. 64 a. 4";
    label ru unofficial "возражение 2 против ответа I q. 64 a. 4";
    when q64_a4_arg2_premise1() and q64_a4_arg2_premise2() and q64_a4_arg2_premise3()
        and not_known(q64_a4_reply2());
    then not q64_a4_thesis();
}
