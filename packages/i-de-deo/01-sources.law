}

publication ST_TEXT_Q26 of LEONINA_CT_Q26 {
    media_type "text/plain; charset=utf-8";
    uri "https://www.corpusthomisticum.org/sth1015.html";
    retrieved_at @2026-09-18T21:00:00Z;
    content_hash "sha256:f1ba191e480b522186309df657e783565985767fc8826696cfe522086c17e138";
    local_path "sources/summa-theologiae-i-de-deo/q26.la.txt";
}

fragment ST_I_Q26_PR in LEONINA_CT_Q26 {
    kind paragraph;
    locator "question/26/prooemium";
    text la official """Ultimo autem, post considerationem eorum quae ad divinae essentiae unitatem pertinent, considerandum est de divina beatitudine. Et circa hoc quaeruntur quatuor. Primo, utrum beatitudo Deo competat. Secundo, secundum quid dicitur Deus esse beatus, utrum secundum actum intellectus. Tertio, utrum sit essentialiter beatitudo cuiuslibet beati. Quarto, utrum in eius beatitudine omnis beatitudo includatur.""";
    content_hash "sha256:4963595b967c2549cbcbe6d10eca6444a46248618d27d02cba23cfc3a63e509b";
}

fragment ST_I_Q26_A1_ARG1 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-1/objection/1";
    text la official """Ad primum sic proceditur. Videtur quod beatitudo Deo non conveniat. Beatitudo enim, secundum Boetium, in III de Consol., est status omnium bonorum aggregatione perfectus. Sed aggregatio bonorum non habet locum in Deo, sicut nec compositio. Ergo Deo non convenit beatitudo.""";
    content_hash "sha256:26a7092a58de415132e95d5b5f7aef9f91cbe16ed9b32a299769417455346972";
}

fragment ST_I_Q26_A1_ARG2 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-1/objection/2";
    text la official """Praeterea, beatitudo, sive felicitas, est praemium virtutis, secundum philosophum, in I Ethic. Sed Deo non convenit praemium, sicut nec meritum. Ergo nec beatitudo.""";
    content_hash "sha256:2b93a95aaeae728f8dbf9ed8b399919e82efdc52b9ce5e41e3dc6c9ee136b720";
}

fragment ST_I_Q26_A1_SC in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-1/sed-contra";
    text la official """Sed contra est quod dicit apostolus, I ad Tim. ultimo, quem suis temporibus ostendet Deus beatus et solus potens, rex regum et dominus dominantium.""";
    content_hash "sha256:166606033f7dd5e6b562b1398e2667b805aa902c6a9100b031dd26ca3bc6de94";
}

fragment ST_I_Q26_A1_RESP in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-1/respondeo";
    text la official """Respondeo dicendum quod beatitudo maxime Deo competit. Nihil enim aliud sub nomine beatitudinis intelligitur, nisi bonum perfectum intellectualis naturae; cuius est suam sufficientiam cognoscere in bono quod habet; et cui competit ut ei contingat aliquid vel bene vel male, et sit suarum operationum domina. Utrumque autem istorum excellentissime Deo convenit, scilicet perfectum esse, et intelligentem. Unde beatitudo maxime convenit Deo.""";
    content_hash "sha256:669b8bab769e58d035acf28e224c63c8accff45264f005138cfb384ba48b6d89";
}

fragment ST_I_Q26_A1_AD1 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-1/reply/1";
    text la official """Ad primum ergo dicendum quod aggregatio bonorum est in Deo non per modum compositionis, sed per modum simplicitatis, quia quae in creaturis multiplicia sunt, in Deo praeexistunt simpliciter et unite, ut supra dictum est.""";
    content_hash "sha256:631878c29b405953233ee03ead285b20290e65b52c8f459a71eb2fc32314a48a";
}

fragment ST_I_Q26_A1_AD2 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-1/reply/2";
    text la official """Ad secundum dicendum quod esse praemium virtutis accidit beatitudini vel felicitati, inquantum aliquis beatitudinem acquirit, sicut esse terminum generationis accidit enti, inquantum exit de potentia in actum. Sicut igitur Deus habet esse, quamvis non generetur; ita habet beatitudinem, quamvis non mereatur.""";
    content_hash "sha256:fd642ad9e23ef500fa96f0d6b9038d889b2eef826bf926458b45ca64828f21fd";
}

fragment ST_I_Q26_A2_ARG1 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-2/objection/1";
    text la official """Ad secundum sic proceditur. Videtur quod Deus non dicatur beatus secundum intellectum. Beatitudo enim est summum bonum. Sed bonum dicitur in Deo secundum essentiam, quia bonum respicit esse, quod est secundum essentiam, secundum Boetium, in libro de Hebdomad. Ergo et beatitudo dicitur in Deo secundum essentiam, et non secundum intellectum.""";
    content_hash "sha256:9383fc15399c4f7ef543e5a280afe02cc96be9b10f9098312aaebbdc6c8a09bc";
}

fragment ST_I_Q26_A2_ARG2 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-2/objection/2";
    text la official """Praeterea, beatitudo habet rationem finis. Finis autem est obiectum voluntatis, sicut et bonum. Ergo beatitudo dicitur in Deo secundum voluntatem, et non secundum intellectum.""";
    content_hash "sha256:c76f4055b78d065498b256f8163885c0cc3ee79daa93499c99d0e2d21c0432ae";
}

fragment ST_I_Q26_A2_SC in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-2/sed-contra";
    text la official """Sed contra est quod Gregorius dicit, XXXII Moralium, ipse gloriosus est, qui, dum seipso perfruitur, accedentis laudis indigens non est. Esse autem gloriosum significat esse beatum. Cum igitur Deo fruamur secundum intellectum, quia visio est tota merces, ut dicit Augustinus, videtur quod beatitudo dicatur in Deo secundum intellectum.""";
    content_hash "sha256:e60b13b45921ff754468734fbfdd6e1368240a23f47c4fdad11e008ee331af4b";
}

fragment ST_I_Q26_A2_RESP in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-2/respondeo";
    text la official """Respondeo dicendum quod beatitudo, sicut dictum est, significat bonum perfectum intellectualis naturae. Et inde est quod, sicut unaquaeque res appetit suam perfectionem, ita et intellectualis natura naturaliter appetit esse beata. Id autem quod est perfectissimum in qualibet intellectuali natura, est intellectualis operatio, secundum quam capit quodammodo omnia. Unde cuiuslibet intellectualis naturae creatae beatitudo consistit in intelligendo. In Deo autem non est aliud esse et intelligere secundum rem, sed tantum secundum intelligentiae rationem. Attribuenda ergo est Deo beatitudo secundum intellectum, sicut et aliis beatis, qui per assimilationem ad beatitudinem ipsius, beati dicuntur.""";
    content_hash "sha256:f59791d61bc6ef6032a7eaf51b492d0746bf23708386bb06f62d63fdb76872a0";
}

fragment ST_I_Q26_A2_AD1 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-2/reply/1";
    text la official """Ad primum ergo dicendum quod ex illa ratione probatur quod Deus sit beatus secundum suam essentiam, non autem quod beatitudo ei conveniat secundum rationem essentiae, sed magis secundum rationem intellectus.""";
    content_hash "sha256:878b4b0305b94c268ecdec0541b53a975b5841b4a20b21998045799aeadc73c9";
}

fragment ST_I_Q26_A2_AD2 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-2/reply/2";
    text la official """Ad secundum dicendum quod beatitudo, cum sit bonum, est obiectum voluntatis. Obiectum autem praeintelligitur actui potentiae. Unde, secundum modum intelligendi, prius est beatitudo divina, quam actus voluntatis in ea requiescentis. Et hoc non potest esse nisi actus intellectus. Unde in actu intellectus attenditur beatitudo.""";
    content_hash "sha256:675ff8e58d9a4900b391a461104a0abce52fd65b4c31a7902732bae08e1c9914";
}

fragment ST_I_Q26_A3_ARG1 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-3/objection/1";
    text la official """Ad tertium sic proceditur. Videtur quod Deus sit beatitudo cuiuslibet beati. Deus enim est summum bonum, ut supra ostensum est. Impossibile est autem esse plura summa bona, ut etiam ex superioribus patet. Cum igitur de ratione beatitudinis sit, quod sit summum bonum, videtur quod beatitudo non sit aliud quam Deus.""";
    content_hash "sha256:cfe7f06f142d4373408e50d996349f080551b151311f8ed32ff31b0d48e4d8b4";
}

fragment ST_I_Q26_A3_ARG2 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-3/objection/2";
    text la official """Praeterea, beatitudo est finis rationalis naturae ultimus. Sed esse ultimum finem rationalis naturae, soli Deo convenit. Ergo beatitudo cuiuslibet beati est solus Deus.""";
    content_hash "sha256:c99b782f498e8d96398701477678fe46cb596504e126baadfd90cee42c1dc938";
}

fragment ST_I_Q26_A3_SC in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-3/sed-contra";
    text la official """Sed contra, beatitudo unius est maior beatitudine alterius, secundum illud I Cor. XV, stella differt a stella in claritate. Sed Deo nihil est maius. Ergo beatitudo est aliquid aliud quam Deus.""";
    content_hash "sha256:24e00284fcafbd6c4d49159d783a1b9fcb790a2702ecb55c23e55bf6f3c7a92a";
}

fragment ST_I_Q26_A3_RESP in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-3/respondeo";
    text la official """Respondeo dicendum quod beatitudo intellectualis naturae consistit in actu intellectus. In quo duo possunt considerari, scilicet obiectum actus, quod est intelligibile; et ipse actus, qui est intelligere. Si igitur beatitudo consideretur ex parte ipsius obiecti, sic solus Deus est beatitudo, quia ex hoc solo est aliquis beatus, quod Deum intelligit; secundum illud Augustini, in V libro Confess., beatus est qui te novit, etiam si alia ignoret. Sed ex parte actus intelligentis, beatitudo est quid creatum in creaturis beatis, in Deo autem est etiam secundum hoc, aliquid increatum.""";
    content_hash "sha256:ad63f6b9205d57cd7d2b61dfedc9692661b4db547c5101a0f3f0f78de320288d";
}

fragment ST_I_Q26_A3_AD1 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-3/reply/1";
    text la official """Ad primum ergo dicendum quod beatitudo, quantum ad obiectum, est summum bonum simpliciter, sed quantum ad actum, in creaturis beatis, est summum bonum, non simpliciter, sed in genere bonorum participabilium a creatura.""";
    content_hash "sha256:db0b57b1b18d0f33ceed60e8da5ffb1727f859bdd13d26e1ef02ce03f90dad1c";
}

fragment ST_I_Q26_A3_AD2 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-3/reply/2";
    text la official """Ad secundum dicendum quod finis est duplex, scilicet cuius et quo, ut philosophus dicit, scilicet ipsa res, et usus rei, sicut avaro est finis pecunia, et acquisitio pecuniae. Creaturae igitur rationalis est quidem Deus finis ultimus ut res; beatitudo autem creata ut usus, vel magis fruitio, rei.""";
    content_hash "sha256:822e892f7fd8e0b350c84fc3724a622a1f313a16b233ecba2a44cd78355c8adc";
}

fragment ST_I_Q26_A4_ARG1 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-4/objection/1";
    text la official """Ad quartum sic proceditur. Videtur quod beatitudo divina non complectatur omnes beatitudines. Sunt enim quaedam beatitudines falsae. Sed in Deo nihil potest esse falsum. Ergo divina beatitudo non complectitur omnem beatitudinem.""";
    content_hash "sha256:b6f58d19ba0489a3b5a625686d15404426c51d2d661a6c6829b654131610f8cf";
}

fragment ST_I_Q26_A4_ARG2 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-4/objection/2";
    text la official """Praeterea, quaedam beatitudo, secundum quosdam, consistit in rebus corporalibus, sicut in voluptatibus, divitiis, et huiusmodi, quae quidem Deo convenire non possunt, cum sit incorporeus. Ergo beatitudo eius non complectitur omnem beatitudinem.""";
    content_hash "sha256:0c28c6283f2edc6b4cb9c021091558973843acfb3d0b863b14618ddd5139a4f5";
}

fragment ST_I_Q26_A4_SC in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-4/sed-contra";
    text la official """Sed contra est quod beatitudo est perfectio quaedam. Divina autem perfectio complectitur omnem perfectionem, ut supra ostensum est. Ergo divina beatitudo complectitur omnem beatitudinem.""";
    content_hash "sha256:d9f313b24410025cb1f167d95b3c2031b4795ad718c708cbd32ced07dfee0987";
}

fragment ST_I_Q26_A4_RESP in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-4/respondeo";
    text la official """Respondeo dicendum quod quidquid est desiderabile in quacumque beatitudine, vel vera vel falsa, totum eminentius in divina beatitudine praeexistit. De contemplativa enim felicitate, habet continuam et certissimam contemplationem sui et omnium aliorum, de activa vero, gubernationem totius universi. De terrena vero felicitate, quae consistit in voluptate, divitiis, potestate, dignitate et fama, secundum Boetium, in III de Consol., habet gaudium de se et de omnibus aliis, pro delectatione, pro divitiis, habet omnimodam sufficientiam, quam divitiae promittunt, pro potestate, omnipotentiam, pro dignitate, omnium regimen, pro fama vero, admirationem totius creaturae.""";
    content_hash "sha256:ab36481927081c4c76beb77f50c32ad9d1f2863763017f6f9fcab8ec3c961134";
}

fragment ST_I_Q26_A4_AD1 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-4/reply/1";
    text la official """Ad primum ergo dicendum quod beatitudo aliqua secundum hoc est falsa, secundum quod deficit a ratione verae beatitudinis, et sic non est in Deo. Sed quidquid habet de similitudine, quantumcumque tenui, beatitudinis, totum praeexistit in divina beatitudine.""";
    content_hash "sha256:4cfe3d8e58d10e640b40439c1bb54862633d9db95a160d9f24a8bd64470d1617";
}

fragment ST_I_Q26_A4_AD2 in LEONINA_CT_Q26 {
    kind paragraph;
    locator "section/26-4/reply/2";
    text la official """Ad secundum dicendum quod bona quae sunt in corporalibus corporaliter, in Deo sunt spiritualiter, secundum modum suum. Et haec dicta sufficiant de his quae pertinent ad divinae essentiae unitatem.""";
    content_hash "sha256:d949afd29bed984e58d548b510f340caaeeb1b471a31809ecf52a53554e2b8d8";
}
