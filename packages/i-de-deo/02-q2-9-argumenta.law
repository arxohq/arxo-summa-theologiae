    label ru unofficial "ответ на возражение III вопроса IX, артикула II";
}
@source(ST_I_Q9_A2_ARG3)
rule Q9A2Obiectio3 defeasible {
    label la official "Videtur quod, obiectio 3, I q. 9 a. 2";
    label ru unofficial "возражение 3 против ответа I q. 9 a. 2";
    when q9_a2_arg3_premise1() and q9_a2_arg3_premise2()
        and not_known(q9_a2_reply3());
    then not q9_a2_thesis();
}
@source(ST_I_Q9_A2_SC)
assert q9_a2_thesis() { evidence ST_TEXT_Q9; }
