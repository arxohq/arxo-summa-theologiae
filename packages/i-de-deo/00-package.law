// Словарь трактата I qq. 2-26.
// Графы quaestio порождаются sync_summa_treatise.py.
// Прикладной слой применяет respondeo, не передоказывает возражения.

language "law.core" version "0.2";
package la.aquinas.summa.i_de_deo version "0.1.0";
namespace "urn:la:aquinas:clir:summa-i-de-deo";

entity Subject {
    label la official "res examinata";
    label ru unofficial "предъявленный предмет respondeo";
}

pub relation presented(s: Subject) kind empirical {
    label la official "res examinata proposita est";
    label ru unofficial "предмет предъявлен к оценке";
}
pub relation god_considered(s: Subject) kind empirical {
    label la unofficial "god_considered";
    label ru unofficial "god_considered";
}
pub relation question_of_existence(s: Subject) kind empirical {
    label la unofficial "question_of_existence";
    label ru unofficial "question_of_existence";
}
