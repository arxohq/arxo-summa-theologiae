// Словарь трактата I-II qq. 71-89.
// Графы quaestio порождаются sync_summa_treatise.py.
// Прикладной слой применяет respondeo, не передоказывает возражения.

language "law.core" version "0.2";
package la.aquinas.summa.i_ii_vitiis version "0.1.0";
namespace "urn:la:aquinas:clir:summa-i-ii-vitiis";

entity Subject {
    label la official "res examinata";
    label ru unofficial "предъявленный предмет respondeo";
}

pub relation presented(s: Subject) kind empirical {
    label la official "res examinata proposita est";
    label ru unofficial "предмет предъявлен к оценке";
}
pub relation ignorance_presented(s: Subject) kind empirical {
    label la unofficial "ignorance_presented";
    label ru unofficial "ignorance_presented";
}
pub relation sin_presented(s: Subject) kind empirical {
    label la unofficial "sin_presented";
    label ru unofficial "sin_presented";
}
pub relation vice_presented(s: Subject) kind empirical {
    label la unofficial "vice_presented";
    label ru unofficial "vice_presented";
}
