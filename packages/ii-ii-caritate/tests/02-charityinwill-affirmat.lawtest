language "law.core" version "0.2";
package la.aquinas.summa.ii_ii_caritate version "0.1.0";
namespace "urn:la:aquinas:clir:summa-ii-ii-caritate";

test "urn:query:ii-ii-caritate-charityinwill-affirmat" {
    given {
        context {
            legal_time @1270-06-01;
            decision_time @1270-06-01T12:00:00Z;
            knowledge_time @1270-06-01T12:00:00Z;
            timezone "UTC";
        }
        assert "p": presented(entity_ref("urn:case:st:ii_ii_caritate:s")) { origin case_input; }
        assert "f": charity_presented(entity_ref("urn:case:st:ii_ii_caritate:s")) { origin case_input; }
    }
    evaluate truth(charity_in_will(entity_ref("urn:case:st:ii_ii_caritate:s")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
