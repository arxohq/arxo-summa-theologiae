language "law.core" version "0.2";
package la.aquinas.summa.iii_incarnatione version "0.1.0";
namespace "urn:la:aquinas:clir:summa-iii-incarnatione";

test "urn:query:iii-incarnatione-unioninperson-affirmat" {
    given {
        context {
            legal_time @1270-06-01;
            decision_time @1270-06-01T12:00:00Z;
            knowledge_time @1270-06-01T12:00:00Z;
            timezone "UTC";
        }
        assert "p": presented(entity_ref("urn:case:st:iii_incarnatione:s")) { origin case_input; }
        assert "f": incarnation_considered(entity_ref("urn:case:st:iii_incarnatione:s")) { origin case_input; }
    }
    evaluate truth(union_in_person(entity_ref("urn:case:st:iii_incarnatione:s")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
