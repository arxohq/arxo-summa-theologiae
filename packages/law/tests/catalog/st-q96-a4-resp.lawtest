language "law.core" version "0.2";
package la.aquinas.summa_theologiae_law version "0.1.0";
namespace "urn:la:aquinas:clir:summa-theologiae-law";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// закон против божественного блага исполнять нельзя
test "CATALOG-DIVINEGOODCONTRARYLAWMUSTNOTBEOBEYED" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": contrary_to_divine_good(entity_ref("urn:law:catalog:divinegoodcontrarylawmustnotbeobeyed:v0")) { origin case_input; }
        assert "cat-1": enacted_human_law(entity_ref("urn:law:catalog:divinegoodcontrarylawmustnotbeobeyed:v0")) { origin case_input; }
    }
    evaluate truth(must_not_be_obeyed(entity_ref("urn:law:catalog:divinegoodcontrarylawmustnotbeobeyed:v0")));
    expect truth_status == TRUE_ONLY;
}

// несправедливое установление может соблюдаться ради предотвращения соблазна или возмущения без признания его моральной силы
test "CATALOG-AVOIDSCANDALWITHOUTMORALVALIDATION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": scandal_or_disturbance_without_compliance(entity_ref("urn:law:catalog:avoidscandalwithoutmoralvalidation:v0")) { origin case_input; }
        assert "cat-1": contrary_to_human_good(entity_ref("urn:law:catalog:avoidscandalwithoutmoralvalidation:v0")) { origin case_input; }
    }
    evaluate truth(compliance_tolerated_to_avoid_scandal(entity_ref("urn:law:catalog:avoidscandalwithoutmoralvalidation:v0")));
    expect truth_status == TRUE_ONLY;
}

// установленный человеческий закон prima facie претендует на обязательность в совести
test "CATALOG-HUMANLAWCLAIMSCONSCIENCEBINDING" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": enacted_human_law(entity_ref("urn:law:catalog:humanlawclaimsconsciencebinding:v0")) { origin case_input; }
    }
    evaluate truth(binds_in_conscience(entity_ref("urn:law:catalog:humanlawclaimsconsciencebinding:v0")));
    expect truth_status == TRUE_ONLY;
}
