language "law.core" version "0.2";
package la.aquinas.summa.i_ii_habitibus version "0.1.0";
namespace "urn:la:aquinas:clir:summa-i-ii-habitibus";

test "urn:query:i-ii-habitibus-habitsdistinguishedbyobjects-affirmat" {
    given {
        context {
            legal_time @1270-06-01;
            decision_time @1270-06-01T12:00:00Z;
            knowledge_time @1270-06-01T12:00:00Z;
            timezone "UTC";
        }
        assert "p": presented(entity_ref("urn:case:st:i_ii_habitibus:s")) { origin case_input; }
        assert "f": habit_presented(entity_ref("urn:case:st:i_ii_habitibus:s")) { origin case_input; }
    }
    evaluate truth(habits_by_objects(entity_ref("urn:case:st:i_ii_habitibus:s")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
