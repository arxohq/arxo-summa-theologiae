language "law.core" version "0.2";
package la.aquinas.summa.i_ii_actibus version "0.1.0";
namespace "urn:la:aquinas:clir:summa-i-ii-actibus";

test "urn:query:i-ii-actibus-actsgoodorevil-affirmat" {
    given {
        context {
            legal_time @1270-06-01;
            decision_time @1270-06-01T12:00:00Z;
            knowledge_time @1270-06-01T12:00:00Z;
            timezone "UTC";
        }
        assert "p": presented(entity_ref("urn:case:st:i_ii_actibus:s")) { origin case_input; }
        assert "f": human_act_presented(entity_ref("urn:case:st:i_ii_actibus:s")) { origin case_input; }
    }
    evaluate truth(act_moral(entity_ref("urn:case:st:i_ii_actibus:s")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
