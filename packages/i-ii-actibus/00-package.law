// Словарь трактата I-II qq. 6-21.
// Графы quaestio порождаются sync_summa_treatise.py.
// Прикладной слой применяет respondeo, не передоказывает возражения.

language "law.core" version "0.2";
package la.aquinas.summa.i_ii_actibus version "0.1.0";
namespace "urn:la:aquinas:clir:summa-i-ii-actibus";

entity Subject {
    label la official "res examinata";
    label ru unofficial "предъявленный предмет respondeo";
}

pub relation presented(s: Subject) kind empirical {
    label la official "res examinata proposita est";
    label ru unofficial "предмет предъявлен к оценке";
}
pub relation act_presented(s: Subject) kind empirical {
    label la unofficial "act_presented";
    label ru unofficial "act_presented";
}
pub relation human_act_presented(s: Subject) kind empirical {
    label la unofficial "human_act_presented";
    label ru unofficial "human_act_presented";
}
pub relation object_presented(s: Subject) kind empirical {
    label la unofficial "object_presented";
    label ru unofficial "object_presented";
}
