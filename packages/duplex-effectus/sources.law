publication ST_TEXT_Q64_A7 of LEONINA_CT_Q64_A7 {
    media_type "text/plain; charset=utf-8";
    uri "https://www.corpusthomisticum.org/sth3064.html";
    retrieved_at @2026-09-18T18:00:00Z;
    content_hash "sha256:626bb08d5247c1d9eb1c9f5503b0ac148a0dd388fa523f6b8608dcd80b36c80d";
    local_path "sources/aquinas-duplex-effectus/q64-a7.la.txt";
}

fragment ST_Q64_A7_ARG1 in LEONINA_CT_Q64_A7 {
    kind paragraph;
    locator "section/64-7/objection/1";
    text la official """Ad septimum sic proceditur. Videtur quod non liceat alicui occidere hominem se defendendo. Dicit enim Augustinus, ad Publicolam, de occidendis hominibus, ne ab eis quisquam occidatur, non mihi placet consilium, nisi forte sit miles, aut publica functione teneatur, ut non pro se hoc faciat, sed pro aliis, accepta legitima potestate, si eius congruat personae. Sed ille qui se defendendo hominem occidit, occidit ne ipse occidatur. Ergo hoc non licet.""";
    content_hash "sha256:1c2916f3d50fb513f5b3b4d334daf44c6f785f107323f833ec91f124d8a5d254";
}

fragment ST_Q64_A7_ARG2 in LEONINA_CT_Q64_A7 {
    kind paragraph;
    locator "section/64-7/objection/2";
    text la official """Praeterea, in I de Libero Arbitrio dicitur, quomodo apud divinam providentiam a peccato immunes erunt qui pro his rebus quas contemni oportet, homines occiderint? Has autem res dicit esse quas inviti amittere possumus. Inter quas primum locum tenet vita corporalis. Ergo pro conservatione vitae corporalis non licet hominem occidere.""";
    content_hash "sha256:c4c0f36dfad2278b23b88102a062a31eaaac4ab2305e0712cd8735483474372a";
}

fragment ST_Q64_A7_ARG3 in LEONINA_CT_Q64_A7 {
    kind paragraph;
    locator "section/64-7/objection/3";
    text la official """Praeterea, Nicolaus Papa dicit, et habetur in decretis, de clericis pro quibus consuluisti, scilicet qui se defendendo paganum occiderunt, si post satisfactionem ad pristinum statum redire, vel ad altiorem gradum possunt conscendere, scito nos in nullum homicidium consensum praebere, nec sub qualibet occasione hominem a clericis occidi posse. Sed clerici et laici tenentur ad observantiam praeceptorum moralium. Ergo nec laicis licet hominem occidere se defendendo.""";
    content_hash "sha256:c5b5e726ee691ce87c0c57e79ea459df9981094b19a480a6a753261a3fcbf237";
}

fragment ST_Q64_A7_SC in LEONINA_CT_Q64_A7 {
    kind paragraph;
    locator "section/64-7/sed-contra";
    text la official """Sed contra est quod Exod. XXII dicitur, si effringens fur domum inventus fuerit, et accepto vulnere mortuus fuerit, percussor non erit reus sanguinis. Sed multo magis licet defendere vitam suam quam domum. Ergo etiam si aliquis occidat hominem pro conservatione vitae suae, non erit reus homicidii.""";
    content_hash "sha256:fc258d70988ea7266a059e7092b493d5912e17f7ba33c87edb3f85a5f64f622c";
}

fragment ST_Q64_A7_RESP in LEONINA_CT_Q64_A7 {
    kind paragraph;
    locator "section/64-7/respondeo";
    text la official """Respondeo dicendum quod nihil prohibet unius actus esse duos effectus, quorum alter solum sit in intentione, alius vero sit praeter intentionem. Morales autem actus recipiunt speciem secundum id quod intenditur, non autem ab eo quod est praeter intentionem, cum sit per accidens, ut ex supra dictis patet. Ex actu igitur alicuius seipsum defendentis duplex effectus sequi potest, unus quidem conservatio propriae vitae; alius autem occisio invadentis. Actus igitur huiusmodi ex hoc quod intenditur conservatio propriae vitae, non habet rationem illiciti, cum hoc sit cuilibet naturale quod se conservet in esse quantum potest. Potest tamen aliquis actus ex bona intentione proveniens illicitus reddi si non sit proportionatus fini. Et ideo si aliquis ad defendendum propriam vitam utatur maiori violentia quam oporteat, erit illicitum. Si vero moderate violentiam repellat, erit licita defensio, nam secundum iura, vim vi repellere licet cum moderamine inculpatae tutelae. Nec est necessarium ad salutem ut homo praetermittat actum moderatae tutelae ad evitandum occisionem alterius, quia plus tenetur homo vitae suae providere quam vitae alienae. Sed quia occidere hominem non licet nisi publica auctoritate propter bonum commune, ut ex supra dictis patet; illicitum est quod homo intendat occidere hominem ut seipsum defendat, nisi ei qui habet publicam auctoritatem, qui, intendens hominem occidere ad sui defensionem, refert hoc ad publicum bonum, ut patet in milite pugnante contra hostes, et in ministro iudicis pugnante contra latrones. Quamvis et isti etiam peccent si privata libidine moveantur.""";
    content_hash "sha256:705800a5a0f9d6b183e41331310f1d8c6d57f25289332712d183217f19958bcc";
}

fragment ST_Q64_A7_AD1 in LEONINA_CT_Q64_A7 {
    kind paragraph;
    locator "section/64-7/reply/1";
    text la official """Ad primum ergo dicendum quod auctoritas Augustini est intelligenda in eo casu quo quis intendat occidere hominem ut seipsum a morte liberet.""";
    content_hash "sha256:6dbdb9d644ce2a0cf2c918fbda87ab54083a6274b52b6c808e811f9f14c8d6bf";
}

fragment ST_Q64_A7_AD2 in LEONINA_CT_Q64_A7 {
    kind paragraph;
    locator "section/64-7/reply/2";
    text la official """Et per hoc patet responsio ad secundum. In quo etiam casu locum habet auctoritas inducta in secundam rationem. Et ideo signanter dicit, pro his rebus, in quo designatur intentio.""";
    content_hash "sha256:8e3c7f6b715c640d50cbc2377d1cb3a242a0b0313efc8f168564c352169a1c0c";
}

fragment ST_Q64_A7_AD3 in LEONINA_CT_Q64_A7 {
    kind paragraph;
    locator "section/64-7/reply/3";
    text la official """Ad tertium dicendum quod irregularitas consequitur actum homicidii etiam si sit sine peccato, sicut patet in iudice qui iuste hominem condemnat ad mortem. Et ideo clericus, si etiam se defendendo occidat aliquem, irregularis est, quamvis non intendat occidere, sed seipsum defendere.""";
    content_hash "sha256:d8e69432eb5a25d50381ae0471d37b03a92f23bc7084886ee21f9eb4b9b20029";
}
