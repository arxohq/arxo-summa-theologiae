fragment ST_Q40_A1_ARG1 in LEONINA_CT_Q40_A1 {
    kind paragraph;
    locator "section/40-1/objection/1";
    text la official """Ad primum sic proceditur. Videtur quod bellare sit semper peccatum. Poena enim non infligitur nisi pro peccato. Sed bellantibus Dominus denuntiat, omnis qui gladium acceperit gladio peribit, ut dicitur Matth. XXVI. Ergo omne bellum est illicitum.""";
    content_hash "sha256:2f125a507b5ad3a7ba6e5d29a975d028ffad47643700fe2982c0d8e9eaaa5883";
}

fragment ST_Q40_A1_ARG2 in LEONINA_CT_Q40_A1 {
    kind paragraph;
    locator "section/40-1/objection/2";
    text la official """Praeterea, quidquid est contrarium praecepto divino est peccatum. Sed bellare est contrarium praecepto divino, dicitur enim Matth. V, ego autem dico vobis non resistere malo; et Rom. XII, non vos defendentes, carissimi, sed date locum irae. Ergo bellare semper est peccatum.""";
    content_hash "sha256:c462ffeff947a9303c0247693dd80742f8a035aef260f8e6ec389cbe00876d8b";
}

fragment ST_Q40_A1_ARG3 in LEONINA_CT_Q40_A1 {
    kind paragraph;
    locator "section/40-1/objection/3";
    text la official """Praeterea, nihil nisi peccatum opponitur virtuti. Sed bellum opponitur paci. Ergo bellum semper est peccatum.""";
    content_hash "sha256:47794aebc2a4cde5a9bf5d1c4dbb68d0f430c3159bf79bd54b627057d7e3bef0";
}

fragment ST_Q40_A1_SC in LEONINA_CT_Q40_A1 {
    kind paragraph;
    locator "section/40-1/sed-contra";
    text la official """Sed contra est quod dicitur Luc. III, milites interrogabant Ioannem, et quid faciemus nos? Et ille respondit, neminem concutiatis, neque calumniam faciatis, et contenti estote stipendiis vestris. Quos tamen in officio militari detinuit. Non autem detineret qui eos in officio peccati detineret. Ergo bellare non est peccatum.""";
    content_hash "sha256:388ac094644b0826dc6ecd04365f557f6d124713f724a44de87ec4c33da7252d";
}

fragment ST_Q40_A1_RESP in LEONINA_CT_Q40_A1 {
    kind paragraph;
    locator "section/40-1/respondeo";
    text la official """Respondeo dicendum quod ad hoc quod aliquod bellum sit iustum, tria requiruntur. Primo quidem, auctoritas principis, cuius mandato bellum est gerendum. Non enim pertinet ad personam privatam bellum movere, quia potest ius suum in iudicio superioris prosequi. Sed quia cura reipublicae commissa est principibus, ad eos pertinet rem publicam civitatis vel regni seu provinciae sibi subditae tueri. Et sicut licite defendunt eam materiali gladio contra interiores perturbatores, dum malefactores puniunt, secundum illud apostoli, ad Rom. XIII, non sine causa gladium portat, vindex est enim iram Dei in eos qui male agunt; ita etiam gladio bellico ad eos pertinet rem publicam tueri ab exterioribus hostibus. Unde et principibus dicitur in Psalm., eripite pauperem, et egenum de manu peccatoris liberate. Unde Augustinus dicit, contra Faust., ordo naturalis mortalium paci accommodatus hoc poscit, ut suscipiendi belli auctoritas atque consilium penes principes sit. Secundo, requiritur causa iusta, ut scilicet illi qui impugnantur propter aliquam culpam impugnationem mereantur. Unde Augustinus dicit, in libro quaest., iusta bella definiri solent quae ulciscuntur iniurias, si gens vel civitas plectenda est quae vel vindicare neglexerit quod a suis improbe factum est, vel reddere quod per iniuriam ablatum est. Tertio, requiritur ut sit intentio bellantium recta, qua scilicet intenditur vel ut bonum promoveatur, vel ut malum vitetur. Unde Augustinus dicit, in libro de verbis Dom., apud veros Dei cultores etiam illa bella peccata non sunt quae non cupiditate aut crudelitate, sed pacis studio geruntur, ut mali coerceantur et boni subleventur. Potest autem contingere ut bellum sit declaratum auctoritate legitima et sit causa iusta, et tamen propter pravam intentionem bellum reddatur illicitum. Unde Augustinus dicit, contra Faust., nocendi cupiditas, ulciscendi crudelitas, implacatus et implacabilis animus, feritas rebellandi, libido dominandi, et si qua sunt similia, haec sunt quae in bellis iure culpantur.""";
    content_hash "sha256:d14444e8d9b81219684df6547fe4d5442a17e5d8e86a3af8c202e042ac4805a9";
}

fragment ST_Q40_A1_AD1 in LEONINA_CT_Q40_A1 {
    kind paragraph;
    locator "section/40-1/reply/1";
    text la official """Ad primum ergo dicendum quod, sicut Augustinus dicit, contra Faust., accipere gladium est eum sine superioris vel legitimae potestatis iussu vel concessu in sanguinem arripere. Qui vero gladio potestatis publica utitur vel iussu principis vel iudicis, si sit persona privata; vel auctoritate propria, si sit princeps publica potestate utens, non ipse accipit gladium, sed a superiori sibi commisso utitur. Unde eis non debetur poena.""";
    content_hash "sha256:39c8b38b64816e18549fc7e58250fb96e78138d46ede8186cbab251baabf4ac5";
}

fragment ST_Q40_A1_AD2 in LEONINA_CT_Q40_A1 {
    kind paragraph;
    locator "section/40-1/reply/2";
    text la official """Ad secundum dicendum quod huiusmodi praecepta, sicut Augustinus dicit, in libro de Sermone Domini in monte, semper sunt servanda in praeparatione animi, ut scilicet homo sit paratus non resistere, vel non se defendere, si opus fuerit. Sed interdum tamen est aliud agendum propter commune bonum, et etiam eorum cum quibus pugnatur.""";
    content_hash "sha256:9fde41110fcdca220ca88381494f9fc7042ca1122d258424289a006829a76ce6";
}

fragment ST_Q40_A1_AD3 in LEONINA_CT_Q40_A1 {
    kind paragraph;
    locator "section/40-1/reply/3";
    text la official """Ad tertium dicendum quod etiam illi qui iusta bella gerunt pacem intendunt. Et ideo paci non opponuntur, nisi mali, qui pacem perturbant. Unde Augustinus dicit, ad Bonifacium, non enim pax quaeritur ut bellum exerceatur, sed bellum geritur ut pax acquiratur. Esto ergo bellando pacificus, ut eos quos expugnas ad pacis utilitatem vincendo perducas.""";
    content_hash "sha256:0d5d178bc140f0721a7fce866d5bbb20ffd669a7d0154539c44b265b7fb68a23";
}

