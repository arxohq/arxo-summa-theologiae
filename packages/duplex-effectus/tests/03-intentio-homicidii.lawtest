language "law.core" version "0.2";
package la.aquinas.duplex_effectus version "0.1.0";
namespace "urn:la:aquinas:clir:duplex-effectus";

test "urn:query:duplex-03-intentio-homicidii" {
    given {
        context {
            legal_time @1270-06-01;
            decision_time @1270-06-01T12:00:00Z;
            knowledge_time @1270-06-01T12:00:00Z;
            timezone "UTC";
        }
        assert "a0": presented_actus(entity_ref("urn:case:duplex:actus:vindicta")) { origin case_input; }
        assert "a1": defensor(entity_ref("urn:case:duplex:actus:vindicta"), entity_ref("urn:case:duplex:persona:privatus")) { origin case_input; }
        assert "a2": vis_illata(entity_ref("urn:case:duplex:actus:vindicta")) { origin case_input; }
        assert "a3": intentio_occisionis(entity_ref("urn:case:duplex:actus:vindicta")) { origin case_input; }
        assert "a4": vis_moderata(entity_ref("urn:case:duplex:actus:vindicta")) { origin adjudicated; }
        assert "a5": not publicus_minister(entity_ref("urn:case:duplex:persona:privatus")) { origin case_input; }
    }
    evaluate truth(occisio_illicita(entity_ref("urn:case:duplex:actus:vindicta")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
