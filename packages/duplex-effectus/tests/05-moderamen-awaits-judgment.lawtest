language "law.core" version "0.2";
package la.aquinas.duplex_effectus version "0.1.0";
namespace "urn:la:aquinas:clir:duplex-effectus";

test "urn:query:duplex-05-moderamen-awaits-judgment" {
    given {
        context {
            legal_time @1270-06-01;
            decision_time @1270-06-01T12:00:00Z;
            knowledge_time @1270-06-01T12:00:00Z;
            timezone "UTC";
        }
        assert "a0": presented_actus(entity_ref("urn:case:duplex:actus:dubium")) { origin case_input; }
        assert "a1": defensor(entity_ref("urn:case:duplex:actus:dubium"), entity_ref("urn:case:duplex:persona:viator")) { origin case_input; }
        assert "a2": vis_illata(entity_ref("urn:case:duplex:actus:dubium")) { origin case_input; }
        assert "a3": intentio_conservationis_vitae(entity_ref("urn:case:duplex:actus:dubium")) { origin case_input; }
        assert "a4": not intentio_occisionis(entity_ref("urn:case:duplex:actus:dubium")) { origin case_input; }
        assert "a5": not mors_est_medium(entity_ref("urn:case:duplex:actus:dubium")) { origin case_input; }
    }
    evaluate truth(defensio_licita(entity_ref("urn:case:duplex:actus:dubium")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(vis_moderata, Prudens);
    expect judgment_requests(1);
}
