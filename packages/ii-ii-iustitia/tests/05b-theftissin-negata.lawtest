language "law.core" version "0.2";
package la.aquinas.summa.ii_ii_iustitia version "0.1.0";
namespace "urn:la:aquinas:clir:summa-ii-ii-iustitia";

test "urn:query:ii-ii-iustitia-theftissin-negata" {
    given {
        context {
            legal_time @1270-06-01;
            decision_time @1270-06-01T12:00:00Z;
            knowledge_time @1270-06-01T12:00:00Z;
            timezone "UTC";
        }
        assert "p": presented(entity_ref("urn:case:st:ii_ii_iustitia:s")) { origin case_input; }
    }
    evaluate truth(theft_is_sin(entity_ref("urn:case:st:ii_ii_iustitia:s")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
