publication ST_TEXT_Q76 of LEONINA_CT_Q76 {
    media_type "text/plain; charset=utf-8";
    uri "https://www.corpusthomisticum.org/sth3061.html";
    retrieved_at @2026-09-18T21:00:00Z;
    content_hash "sha256:674a7d4bfe38c84737cb960542080ed7704ff980ec1a6411e27b650371c5ed7e";
    local_path "sources/summa-theologiae-ii-ii-iustitia/q76.la.txt";
}

fragment ST_II_II_Q76_PR in LEONINA_CT_Q76 {
    kind paragraph;
    locator "question/76/prooemium";
    text la official """Deinde considerandum est de maledictione. Et circa hoc quaeruntur quatuor. Primo, utrum licite possit aliquis maledicere homini. Secundo, utrum licite possit aliquis maledicere irrationali creaturae. Tertio, utrum maledictio sit peccatum mortale. Quarto, de comparatione eius ad alia peccata.""";
    content_hash "sha256:302f384a85e4e207aa6c557f455eada74957faad9c0ef8070d4d4d609a1fa6be";
}

fragment ST_II_II_Q76_A1_ARG1 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-1/objection/1";
    text la official """Ad primum sic proceditur. Videtur quod non liceat maledicere aliquem. Non est enim licitum praeterire mandatum apostoli, in quo Christus loquebatur, ut dicitur II ad Cor. XIII. Sed ipse praecipit, Rom. XII, benedicite, et nolite maledicere. Ergo non licet aliquem maledicere.""";
    content_hash "sha256:4e3031ab9c9b4ac4f94b96ee9c622260dda2c220692c6167272acaa9c2787db1";
}

fragment ST_II_II_Q76_A1_ARG2 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-1/objection/2";
    text la official """Praeterea, omnes tenentur Deum benedicere, secundum illud Dan. III, benedicite, filii hominum, domino. Sed non potest ex ore eodem procedere benedictio Dei et maledictio hominis, ut probatur Iac. III. Ergo nulli licet aliquem maledicere.""";
    content_hash "sha256:9f9c528483fbb08ce5ab0bed280be6a757582dc678257c410a08dafe2396d16b";
}

fragment ST_II_II_Q76_A1_ARG3 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-1/objection/3";
    text la official """Praeterea, ille qui aliquem maledicit, videtur optare eius malum culpae vel poenae, quia maledictio videtur esse imprecatio quaedam. Sed non licet desiderare malum alterius, quinimmo orare oportet pro omnibus ut liberentur a malo. Ergo nulli licet maledicere.""";
    content_hash "sha256:04b37a4e584108b1ab5de4483e367ca63ec64926e4b432462681919691c1684a";
}

fragment ST_II_II_Q76_A1_ARG4 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-1/objection/4";
    text la official """Praeterea, Diabolus per obstinationem maxime subiectus est malitiae. Sed non licet alicui maledicere Diabolum, sicut nec seipsum, dicitur enim Eccli. XXI, cum maledicit impius Diabolum, maledicit ipse animam suam. Ergo multo minus licet maledicere hominem.""";
    content_hash "sha256:932a2a562c337b18990bdc9175eab557ffb3119ce2effd35823ef791a2f2b054";
}

fragment ST_II_II_Q76_A1_ARG5 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-1/objection/5";
    text la official """Praeterea, Num. XXIII, super illud, quomodo maledicam cui non maledixit dominus? Dicit Glossa, non potest esse iusta maledicendi causa ubi peccantis ignoratur affectus. Sed homo non potest scire affectum alterius hominis, nec etiam utrum sit maledictus a Deo. Ergo nulli licet aliquem hominem maledicere.""";
    content_hash "sha256:b44167372f6117168591411bc6fb7c13d70d00ebd8dc228820c626f12353c76a";
}

fragment ST_II_II_Q76_A1_SC in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-1/sed-contra";
    text la official """Sed contra est quod Deut. XXVII dicitur, maledictus qui non permanet in sermonibus legis huius. Elisaeus etiam pueris sibi illudentibus maledixit, ut habetur IV Reg. II.""";
    content_hash "sha256:33b267f5ae3947f174de30fec7928a25c0762d1684c5531b6e051dd5add5a9f2";
}

fragment ST_II_II_Q76_A1_RESP in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-1/respondeo";
    text la official """Respondeo dicendum quod maledicere idem est quod malum dicere. Dicere autem tripliciter se habet ad id quod dicitur. Uno modo, per modum enuntiationis, sicut aliquis exprimitur modo indicativo. Et sic maledicere nihil est aliud quam malum alterius referre, quod pertinet ad detractionem. Unde quandoque maledici detractores dicuntur. Alio modo dicere se habet ad id quod dicitur per modum causae. Et hoc quidem primo et principaliter competit Deo, qui omnia suo verbo fecit, secundum illud Psalm., dixit, et facta sunt. Consequenter autem competit hominibus, qui verbo suo alios movent per imperium ad aliquid faciendum. Et ad hoc instituta sunt verba imperativi modi. Tertio modo ipsum dicere se habet ad id quod dicitur quasi expressio quaedam affectus desiderantis id quod verbo exprimitur. Et ad hoc instituta sunt verba optativi modi. Praetermisso igitur primo modo maledictionis, qui est per simplicem enuntiationem mali, considerandum est de aliis duobus. Ubi scire oportet quod facere aliquid et velle illud se consequuntur in bonitate et malitia, ut ex supradictis patet. Unde in istis duobus modis, quibus malum dicitur per modum imperantis vel per modum optantis, eadem ratione est aliquid licitum et illicitum. Si enim aliquis imperet vel optet malum alterius inquantum est malum, quasi ipsum malum intendens, sic maledicere utroque modo erit illicitum. Et hoc est maledicere per se loquendo. Si autem aliquis imperet vel optet malum alterius sub ratione boni, sic est licitum. Nec erit maledictio per se loquendo, sed per accidens, quia principalis intentio dicentis non fertur ad malum, sed ad bonum. Contingit autem malum aliquod dici imperando vel optando sub ratione duplicis boni. Quandoque quidem sub ratione iusti. Et sic iudex licite maledicit illum cui praecipit iustam poenam inferri. Et sic etiam Ecclesia maledicit anathematizando. Sic etiam prophetae quandoque imprecantur mala peccatoribus, quasi conformantes voluntatem suam divinae iustitiae (licet huiusmodi imprecationes possint etiam per modum praenuntiationis intelligi). Quandoque vero dicitur aliquod malum sub ratione utilis, puta cum aliquis optat aliquem peccatorem pati aliquam aegritudinem, aut aliquod impedimentum, vel ut ipse melior efficiatur, vel ut saltem ab aliorum nocumento cesset.""";
    content_hash "sha256:36a7d4243c3ecb9a799e65de156bdf58ee6e9bf5c7ceb4d8f481931297c808a6";
}

fragment ST_II_II_Q76_A1_AD1 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-1/reply/1";
    text la official """Ad primum ergo dicendum quod apostolus prohibet maledicere per se loquendo, cum intentione mali.""";
    content_hash "sha256:b056d424ab8b7fe92e2e86876d672c914bad536917b9c49223928726a85c9b27";
}

fragment ST_II_II_Q76_A1_AD2 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-1/reply/2";
    text la official """Et similiter dicendum ad secundum.""";
    content_hash "sha256:ef4a38683a6151e2b3bf62f378e0c7d4b53724fe25555a57de6bc52d95883a4a";
}

fragment ST_II_II_Q76_A1_AD3 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-1/reply/3";
    text la official """Ad tertium dicendum quod optare alicui malum sub ratione boni non contrariatur affectui quo quis simpliciter alicui optat bonum, sed magis habet conformitatem ad ipsum.""";
    content_hash "sha256:757a860cdb1e4b02eb9c50d355965c941d99e7c513b7ee102f9171790b56c964";
}

fragment ST_II_II_Q76_A1_AD4 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-1/reply/4";
    text la official """Ad quartum dicendum quod in Diabolo est considerare naturam, et culpam. Natura quidem eius bona est, et a Deo, nec eam maledicere licet. Culpa autem eius est maledicenda, secundum illud Iob III, maledicant ei qui maledicunt diei. Cum autem peccator maledicit Diabolum propter culpam, seipsum simili ratione iudicat maledictione dignum. Et secundum hoc dicitur maledicere animam suam.""";
    content_hash "sha256:750bd383f95784d3fa8cd38b31670eebd338ef4e9d3727feba3c0015ce611e5e";
}

fragment ST_II_II_Q76_A1_AD5 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-1/reply/5";
    text la official """Ad quintum dicendum quod affectus peccantis, etsi in se non videatur, potest tamen percipi ex aliquo manifesto peccato, pro quo poena est infligenda. Similiter etiam, quamvis sciri non possit quem Deus maledicit secundum finalem reprobationem, potest tamen sciri quis sit maledictus a Deo secundum reatum praesentis culpae.""";
    content_hash "sha256:1406d2e63447fc664873a8c447406a5d3adcad2f60775f22a98643a532390370";
}

fragment ST_II_II_Q76_A2_ARG1 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-2/objection/1";
    text la official """Ad secundum sic proceditur. Videtur quod non liceat creaturam irrationalem maledicere. Maledictio enim praecipue videtur esse licita inquantum respicit poenam. Sed creatura irrationalis non est susceptiva nec culpae nec poenae. Ergo eam maledicere non licet.""";
    content_hash "sha256:07798954d4f13d42958153df1f737ee4d69a2d00a6929c0490c3c021bc438c65";
}

fragment ST_II_II_Q76_A2_ARG2 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-2/objection/2";
    text la official """Praeterea, in creatura irrationali nihil invenitur nisi natura, quam Deus fecit. Hanc autem maledicere non licet, etiam in Diabolo, ut dictum est. Ergo creaturam irrationalem nullo modo licet maledicere.""";
    content_hash "sha256:77ebbb6e2f8c4d36895837ed57d65e916e501ed9f7b2acb7e9c77cbf5b92c258";
}

fragment ST_II_II_Q76_A2_ARG3 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-2/objection/3";
    text la official """Praeterea, creatura irrationalis aut est permanens, sicut corpora; aut est transiens, sicut tempora. Sed sicut Gregorius dicit, in IV Moral., otiosum est maledicere non existenti; vitiosum vero si existeret. Ergo nullo modo licet maledicere creaturae irrationali.""";
    content_hash "sha256:e59de22d962549ea9618a0911c43ed257bc0557c5df356d76b55189a2730d86b";
}

fragment ST_II_II_Q76_A2_SC in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-2/sed-contra";
    text la official """Sed contra est quod dominus maledixit ficulneae, ut habetur Matth. XXI; et Iob maledixit diei suo, ut habetur Iob III.""";
    content_hash "sha256:a054b745923890649f46963f084db896954f57eef3e3c7923ec8e1908b6fde50";
}

fragment ST_II_II_Q76_A2_RESP in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-2/respondeo";
    text la official """Respondeo dicendum quod benedictio vel maledictio ad illam rem proprie pertinet cui potest aliquid bene vel male contingere, scilicet rationali creaturae. Creaturis autem irrationalibus bonum vel malum dicitur contingere in ordine ad creaturam rationalem, propter quam sunt. Ordinantur autem ad eam multipliciter. Uno quidem modo, per modum subventionis, inquantum scilicet ex creaturis irrationalibus subvenitur humanae necessitati. Et hoc modo dominus homini dixit, Gen. III, maledicta terra in opere tuo, ut scilicet per eius sterilitatem homo puniretur. Et ita etiam intelligitur quod habetur Deut. XXVIII, benedicta horrea tua, et infra, maledictum horreum tuum. Sic etiam David maledixit montes Gelboe, secundum Gregorii expositionem. Alio modo creatura irrationalis ordinatur ad rationalem per modum significationis. Et sic dominus maledixit ficulneam, in significationem Iudaeae. Tertio modo ordinatur creatura irrationalis ad rationalem per modum continentis, scilicet temporis vel loci. Et sic maledixit Iob diei nativitatis suae, propter culpam originalem, quam nascendo contraxit, et propter sequentes poenalitates. Et propter hoc etiam potest intelligi David maledixisse montibus Gelboe, ut legitur II Reg. I, scilicet propter caedem populi quae in eis contigerat. Maledicere autem rebus irrationalibus inquantum sunt creaturae Dei, est peccatum blasphemiae. Maledicere autem eis secundum se consideratis, est otiosum et vanum, et per consequens illicitum.""";
    content_hash "sha256:575769d7ef36627a33401082130e6a3a287e1350f69bafb9689f74ff59dc0405";
}

fragment ST_II_II_Q76_A2_AD_ALL in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-2/reply/all";
    text la official """Et per hoc patet responsio ad obiecta.""";
    content_hash "sha256:ca6c4add224740c71e528a656ec8401d024b47fcf55838e283a5bb6de5df6e15";
}

fragment ST_II_II_Q76_A3_ARG1 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-3/objection/1";
    text la official """Ad tertium sic proceditur. Videtur quod maledicere non sit peccatum mortale. Augustinus enim, in homilia de igne Purgatorio, numerat maledictionem inter levia peccata. Haec autem sunt venialia. Ergo maledictio non est peccatum mortale, sed veniale.""";
    content_hash "sha256:aa46a841a651b58c45416914f4f0e2ba1ed4be890620555c54c9e3afc2a4df8d";
}

fragment ST_II_II_Q76_A3_ARG2 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-3/objection/2";
    text la official """Praeterea, ea quae ex levi motu mentis procedunt non videntur esse peccata mortalia. Sed interdum maledictio ex levi motu procedit. Ergo maledictio non est peccatum mortale.""";
    content_hash "sha256:09ffbe00363a6e459878de6c720c3e2d7392dd0794fcb7b8da8e2e8e0366fa29";
}

fragment ST_II_II_Q76_A3_ARG3 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-3/objection/3";
    text la official """Praeterea, gravius est male facere quam maledicere. Sed male facere non semper est peccatum mortale. Ergo multo minus maledicere.""";
    content_hash "sha256:e2b0b795f0d65bf190d5eb9f717e426239c1cd1526ca256088f1765ed932545c";
}

fragment ST_II_II_Q76_A3_SC in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-3/sed-contra";
    text la official """Sed contra, nihil excludit a regno Dei nisi peccatum mortale. Sed maledictio excludit a regno Dei, secundum illud I ad Cor. VI, neque maledici neque rapaces regnum Dei possidebunt. Ergo maledictio est peccatum mortale.""";
    content_hash "sha256:4342efca55d4d06d98e90fdf2ba0545caade57aa02d3fa4cd59aab7d3c86891c";
}

fragment ST_II_II_Q76_A3_RESP in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-3/respondeo";
    text la official """Respondeo dicendum quod maledictio de qua nunc loquimur, est per quam pronuntiatur malum contra aliquem vel imperando vel optando. Velle autem, vel imperio movere ad malum alterius, secundum se repugnat caritati, qua diligimus proximum volentes bonum ipsius. Et ita secundum suum genus est peccatum mortale. Et tanto gravius quanto personam cui maledicimus magis amare et revereri tenemur, unde dicitur Levit. XX, qui maledixerit patri suo et matri, morte moriatur. Contingit tamen verbum maledictionis prolatum esse peccatum veniale, vel propter parvitatem mali quod quis alteri, maledicendo, imprecatur, vel etiam propter affectum eius qui profert maledictionis verba, dum ex levi motu, vel ex ludo, aut ex subreptione aliqua talia verba profert; quia peccata verborum maxime ex affectu pensantur, ut supra dictum est.""";
    content_hash "sha256:27afad0a456b2b1068c7eab32c558efb8f5975b12d2f21ebb7ac4eabc7222986";
}

fragment ST_II_II_Q76_A3_AD_ALL in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-3/reply/all";
    text la official """Et per hoc patet responsio ad obiecta.""";
    content_hash "sha256:ca6c4add224740c71e528a656ec8401d024b47fcf55838e283a5bb6de5df6e15";
}

fragment ST_II_II_Q76_A4_ARG1 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-4/objection/1";
    text la official """Ad quartum sic proceditur. Videtur quod maledictio sit gravius peccatum quam detractio. Maledictio enim videtur esse blasphemia quaedam, ut patet per id quod dicitur in canonica Iudae, quod cum Michael Archangelus, cum Diabolo disputans, altercaretur de Moysi corpore, non est ausus iudicium inferre blasphemiae; et accipitur ibi blasphemia pro maledictione, secundum Glossam. Blasphemia autem est gravius peccatum quam detractio. Ergo maledictio est gravior detractione.""";
    content_hash "sha256:b73f0f162862197db72ad2064fb0c5cb3757d295fa06fd24592e2d2a931eb465";
}

fragment ST_II_II_Q76_A4_ARG2 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-4/objection/2";
    text la official """Praeterea, homicidium est detractione gravius, ut supra dictum est. Sed maledictio est par peccato homicidii, dicit enim Chrysostomus, super Matth., cum dixeris, maledic ei, et domum everte, et omnia perire fac, nihil ab homicida differs. Ergo maledictio est gravior quam detractio.""";
    content_hash "sha256:b830b2eeceef69d4335275bb5650f9aca2228886ae19777320e8213a5767b34b";
}

fragment ST_II_II_Q76_A4_ARG3 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-4/objection/3";
    text la official """Praeterea, causa praeeminet signo. Sed ille qui maledicit causat malum suo imperio, ille autem qui detrahit solum significat malum iam existens. Gravius ergo peccat maledicus quam detractor.""";
    content_hash "sha256:51d37be71c7bbd2a0e2b41fc487030d5db6fbe2f820f64766780ace9d60f70a7";
}

fragment ST_II_II_Q76_A4_SC in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-4/sed-contra";
    text la official """Sed contra est quod detractio non potest bene fieri. Maledictio autem fit bene et male, ut ex dictis patet. Ergo gravior est detractio quam maledictio.""";
    content_hash "sha256:02e7014453afe9866bbe2d2e3ec989fbf1472c1210492497b5253d2bc2876c11";
}

fragment ST_II_II_Q76_A4_RESP in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-4/respondeo";
    text la official """Respondeo dicendum quod, sicut in primo habitum est, duplex est malum, scilicet culpae, et poenae. Malum autem culpae peius est, ut ibidem ostensum est. Unde dicere malum culpae peius est quam dicere malum poenae, dummodo sit idem modus dicendi. Ad contumeliosum igitur, susurronem et detractorem, et etiam derisorem, pertinet dicere malum culpae, sed ad maledicentem, prout nunc loquimur, pertinet dicere malum poenae, non autem malum culpae nisi forte sub ratione poenae. Non tamen est idem modus dicendi. Nam ad praedicta quatuor vitia pertinet dicere malum culpae solum enuntiando, per maledictionem vero dicitur malum poenae vel causando per modum imperii, vel optando. Ipsa autem enuntiatio culpae peccatum est inquantum aliquod nocumentum ex hoc proximo infertur. Gravius autem est nocumentum inferre quam nocumentum desiderare, ceteris paribus. Unde detractio, secundum communem rationem, gravius peccatum est quam maledictio simplex desiderium exprimens. Maledictio vero quae fit per modum imperii, cum habeat rationem causae, potest esse detractione gravior, si maius nocumentum inferat quam sit denigratio famae; vel levior, si minus. Et haec quidem accipienda sunt secundum ea quae per se pertinent ad rationem horum vitiorum. Possunt autem et alia per accidens considerari quae praedicta vitia vel augent vel minuunt.""";
    content_hash "sha256:73ec57de7720a70afc58e65f312b59f35ae710c1d3d640ccc651433cc3df43ac";
}

fragment ST_II_II_Q76_A4_AD1 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-4/reply/1";
    text la official """Ad primum ergo dicendum quod maledictio creaturae inquantum creatura est, redundat in Deum, et sic per accidens habet rationem blasphemiae, non autem si maledicatur creatura propter culpam. Et eadem ratio est de detractione.""";
    content_hash "sha256:48eac5a1d64e0c3075ba7450f6a7b787c18427f34863054b6891c5dc1da7247a";
}

fragment ST_II_II_Q76_A4_AD2 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-4/reply/2";
    text la official """Ad secundum dicendum quod, sicut dictum est, maledictio uno modo includit desiderium mali. Unde si ille qui maledicit velit malum occisionis alterius, desiderio non differt ab homicida. Differt tamen inquantum actus exterior aliquid adiicit voluntati.""";
    content_hash "sha256:54f99f47adcec3c1d0f0c9828799012050c98ecc0d091b14ab41791041daef87";
}

fragment ST_II_II_Q76_A4_AD3 in LEONINA_CT_Q76 {
    kind paragraph;
    locator "section/76-4/reply/3";
    text la official """Ad tertium dicendum quod ratio illa procedit de maledictione secundum quod importat imperium.""";
    content_hash "sha256:5a3640785a83bf49ca25678362185bb6918415c2cd8b052605aa540e6dd60ef1";
}

