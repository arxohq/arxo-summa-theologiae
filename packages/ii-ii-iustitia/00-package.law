// Словарь трактата II-II qq. 57-122.
// Графы quaestio порождаются sync_summa_treatise.py.
// Прикладной слой применяет respondeo, не передоказывает возражения.

language "law.core" version "0.2";
package la.aquinas.summa.ii_ii_iustitia version "0.1.0";
namespace "urn:la:aquinas:clir:summa-ii-ii-iustitia";

entity Subject {
    label la official "res examinata";
    label ru unofficial "предъявленный предмет respondeo";
}

pub relation presented(s: Subject) kind empirical {
    label la official "res examinata proposita est";
    label ru unofficial "предмет предъявлен к оценке";
}
pub relation homicide_presented(s: Subject) kind empirical {
    label la unofficial "homicide_presented";
    label ru unofficial "homicide_presented";
}
pub relation justice_presented(s: Subject) kind empirical {
    label la unofficial "justice_presented";
    label ru unofficial "justice_presented";
}
pub relation theft_presented(s: Subject) kind empirical {
    label la unofficial "theft_presented";
    label ru unofficial "theft_presented";
}
