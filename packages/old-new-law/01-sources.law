    label ru unofficial "Editio Leonina в электронной передаче Corpus Thomisticum, I-II q. 107";
}

publication ST_TEXT_Q107 of LEONINA_CT_Q107 {
    media_type "text/plain; charset=utf-8";
    uri "https://www.corpusthomisticum.org/sth2106.html";
    retrieved_at @2026-09-18T21:00:00Z;
