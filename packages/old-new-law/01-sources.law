}

publication ST_TEXT_Q104 of LEONINA_CT_Q104 {
    media_type "text/plain; charset=utf-8";
    uri "https://www.corpusthomisticum.org/sth2098.html";
    retrieved_at @2026-09-18T21:00:00Z;
