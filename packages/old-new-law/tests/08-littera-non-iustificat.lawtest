language "law.core" version "0.2";
package la.aquinas.summa.i_ii_old_new_law version "0.1.0";
namespace "urn:la:aquinas:clir:summa-i-ii-old-new-law";

test "urn:query:old-new-08-littera-non-iustificat" {
    given {
        context {
            legal_time @1270-06-01;
            decision_time @1270-06-01T12:00:00Z;
            knowledge_time @1270-06-01T12:00:00Z;
            timezone "UTC";
        }
        assert "a0": presented_law(entity_ref("urn:case:st:law:nova-littera")) { origin case_input; }
        assert "a1": is_new_law(entity_ref("urn:case:st:law:nova-littera")) { origin case_input; }
        assert "a2": merely_written_documents(entity_ref("urn:case:st:law:nova-littera")) { origin case_input; }
    }
    evaluate truth(new_law_letter_does_not_justify(entity_ref("urn:case:st:law:nova-littera")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
