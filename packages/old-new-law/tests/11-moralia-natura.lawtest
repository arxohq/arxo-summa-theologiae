language "law.core" version "0.2";
package la.aquinas.summa.i_ii_old_new_law version "0.1.0";
namespace "urn:la:aquinas:clir:summa-i-ii-old-new-law";

test "urn:query:old-new-11-moralia-natura" {
    given {
        context {
            legal_time @1270-06-01;
            decision_time @1270-06-01T12:00:00Z;
            knowledge_time @1270-06-01T12:00:00Z;
            timezone "UTC";
        }
        assert "a0": of_natural_law(entity_ref("urn:case:st:precept:non-occides")) { origin case_input; }
    }
    evaluate truth(precept_kind(entity_ref("urn:case:st:precept:non-occides"), Moral));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
