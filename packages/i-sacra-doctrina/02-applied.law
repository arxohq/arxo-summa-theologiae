// Прикладной канон respondeo I qq. 1-1.

language "law.core" version "0.2";
package la.aquinas.summa.i_sacra_doctrina version "0.1.0";
namespace "urn:la:aquinas:clir:summa-i-sacra-doctrina";

use self::{
    ST_I_Q1_A1_RESP,
    ST_I_Q1_A2_RESP,
    ST_I_Q1_A8_RESP,
    Subject,
    doctrine_presented,
    presented,
    revelation_considered,
};

pub relation doctrine_necessary(s: Subject) kind institutional {
    label la official "necessarium fuit praeter philosophicas disciplinas aliam doctrinam haberi";
    label ru unofficial "помимо философии необходимо иное учение";
}

@source(ST_I_Q1_A1_RESP)
rule SacredDoctrineNecessary(s: Subject) strict {
    label la official "necessarium fuit praeter philosophicas disciplinas aliam doctrinam haberi";
    label ru unofficial "помимо философии необходимо иное учение";
    when presented(s) and revelation_considered(s);
    then doctrine_necessary(s);
}

pub relation doctrine_is_science(s: Subject) kind institutional {
    label la official "sacra doctrina est scientia";
    label ru unofficial "священное учение есть наука";
}

@source(ST_I_Q1_A2_RESP)
rule SacredDoctrineIsScience(s: Subject) strict {
    label la official "sacra doctrina est scientia";
    label ru unofficial "священное учение есть наука";
    when presented(s) and doctrine_presented(s);
    then doctrine_is_science(s);
}

pub relation doctrine_argues(s: Subject) kind institutional {
    label la official "haec doctrina argumentativa est";
    label ru unofficial "это учение пользуется доводами";
}

@source(ST_I_Q1_A8_RESP)
rule SacredDoctrineArgumentative(s: Subject) strict {
    label la official "haec doctrina argumentativa est";
    label ru unofficial "это учение пользуется доводами";
    when presented(s) and doctrine_presented(s);
    then doctrine_argues(s);
}

