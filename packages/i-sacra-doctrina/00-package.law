// Словарь трактата I qq. 1-1.
// Графы quaestio порождаются sync_summa_treatise.py.
// Прикладной слой применяет respondeo, не передоказывает возражения.

language "law.core" version "0.2";
package la.aquinas.summa.i_sacra_doctrina version "0.1.0";
namespace "urn:la:aquinas:clir:summa-i-sacra-doctrina";

entity Subject {
    label la official "res examinata";
    label ru unofficial "предъявленный предмет respondeo";
}

pub relation presented(s: Subject) kind empirical {
    label la official "res examinata proposita est";
    label ru unofficial "предмет предъявлен к оценке";
}
pub relation doctrine_presented(s: Subject) kind empirical {
    label la unofficial "doctrine_presented";
    label ru unofficial "doctrine_presented";
}
pub relation revelation_considered(s: Subject) kind empirical {
    label la unofficial "revelation_considered";
    label ru unofficial "revelation_considered";
}
