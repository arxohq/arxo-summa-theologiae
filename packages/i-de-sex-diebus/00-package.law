// Словарь трактата I qq. 65-74.
// Графы quaestio порождаются sync_summa_treatise.py.
// Прикладной слой применяет respondeo, не передоказывает возражения.

language "law.core" version "0.2";
package la.aquinas.summa.i_de_sex_diebus version "0.1.0";
namespace "urn:la:aquinas:clir:summa-i-de-sex-diebus";

entity Subject {
    label la official "res examinata";
    label ru unofficial "предъявленный предмет respondeo";
}

pub relation presented(s: Subject) kind empirical {
    label la official "res examinata proposita est";
    label ru unofficial "предмет предъявлен к оценке";
}
pub relation creation_considered(s: Subject) kind empirical {
    label la unofficial "creation_considered";
    label ru unofficial "creation_considered";
}
pub relation creature_presented(s: Subject) kind empirical {
    label la unofficial "creature_presented";
    label ru unofficial "creature_presented";
}
