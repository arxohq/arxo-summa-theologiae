language "law.core" version "0.2";
package la.aquinas.summa.i_ii_passionibus version "0.1.0";
namespace "urn:la:aquinas:clir:summa-i-ii-passionibus";

test "urn:query:i-ii-passionibus-passioninsensitive-affirmat" {
    given {
        context {
            legal_time @1270-06-01;
            decision_time @1270-06-01T12:00:00Z;
            knowledge_time @1270-06-01T12:00:00Z;
            timezone "UTC";
        }
        assert "p": presented(entity_ref("urn:case:st:i_ii_passionibus:s")) { origin case_input; }
        assert "f": appetite_presented(entity_ref("urn:case:st:i_ii_passionibus:s")) { origin case_input; }
    }
    evaluate truth(passion_in_sensitive(entity_ref("urn:case:st:i_ii_passionibus:s")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
