publication ST_TEXT_Q22 of LEONINA_CT_Q22 {
    media_type "text/plain; charset=utf-8";
    uri "https://www.corpusthomisticum.org/sth2022.html";
    retrieved_at @2026-09-18T21:00:00Z;
