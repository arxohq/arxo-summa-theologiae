language "law.core" version "0.2";
package la.aquinas.summa.iii_sacramentis version "0.1.0";
namespace "urn:la:aquinas:clir:summa-iii-sacramentis";

test "urn:query:iii-sacramentis-sacramentscausegrace-affirmat" {
    given {
        context {
            legal_time @1270-06-01;
            decision_time @1270-06-01T12:00:00Z;
            knowledge_time @1270-06-01T12:00:00Z;
            timezone "UTC";
        }
        assert "p": presented(entity_ref("urn:case:st:iii_sacramentis:s")) { origin case_input; }
        assert "f": sacrament_presented(entity_ref("urn:case:st:iii_sacramentis:s")) { origin case_input; }
    }
    evaluate truth(sacraments_cause_grace(entity_ref("urn:case:st:iii_sacramentis:s")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
