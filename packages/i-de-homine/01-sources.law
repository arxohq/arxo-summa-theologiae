publication ST_TEXT_Q78 of LEONINA_CT_Q78 {
    media_type "text/plain; charset=utf-8";
    uri "https://www.corpusthomisticum.org/sth1077.html";
    retrieved_at @2026-09-18T21:00:00Z;
    content_hash "sha256:f347edd3572b4165ddd4496eeb75ad462b3f99eb4fa55ea3aec0b189148ac888";
